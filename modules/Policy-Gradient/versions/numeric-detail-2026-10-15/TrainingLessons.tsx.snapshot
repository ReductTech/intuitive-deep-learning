import { useState } from 'react';
import { Button, RangeControl } from '../../shared/react';
import { Page, T, H, F, Controls } from '../components/LessonVisuals';
import { MazeBoard, ARROW } from '../components/ReinforceMaze';
import { A, START, GOAL, DIRECTIONS, DIR_LABEL, returns, transition, random, type Step } from '../mazeModel';
import { DEMO, DEMO_PATH, DEMO_DRAWS, forward, updateNetwork, newNeuralRun, episode, RATE, type Network, type NeuralRun } from '../neuralPolicy';
import './trainingLessons.css';
const cellName=(cell:number)=>cell===START?'起点 S':cell===GOAL?'终点 G':`第 ${Math.floor(cell/4)+1} 行第 ${cell%4+1} 列`;
function goalExample(actions:number[]):Step[]{let cell=START;return actions.map(a=>{const result=transition(cell,DIRECTIONS[a]);const step={state:cell,action:DIRECTIONS[a],probability:forward(DEMO,cell).p[a],...result};cell=result.next;return step;});}
const goalPaths=[goalExample([3,3,0,0,0,3]),goalExample([3,3,3,2,0,0,0,3]),goalExample(Array(30).fill(1))];
export function TrainingOverviewLesson(){return <Page title="策略决定怎么走，目标是平均得分更高" subtitle="πθ(a|s)：权重为 θ 的策略网络，在位置 s 选择动作 a 的概率。" takeaway="调整权重 θ，让当前策略的期望得分 J(θ) 更高。"><div className="pg-tr-goal-visual pg-tr-goal-static"><div className="pg-tr-goal-games">{goalPaths.map((p,i)=><div key={i}><T>{['示例 1 · 6 步到达','示例 2 · 8 步到达','示例 3 · 30 步超时'][i]}</T><Board cell={p.at(-1)!.next} steps={p}/><F latex={[String.raw`5\times(-1)+10=5`,String.raw`7\times(-1)+10=3`,String.raw`30\times(-1)=-30`][i]}/></div>)}</div><div className="pg-tr-goal-formulas"><div><T small tone="accent">① 奖励相加 → 一局得分</T><F latex={String.raw`R=\sum_t r_t`}/><T small>rₜ：本步奖励；Σ：求和。本章 γ = 1，不打折。</T></div><div><T small tone="accent">② 多局得分 → 样本平均</T><F latex={String.raw`\bar R=\frac{5+3-30}{3}\approx-7.33`}/><T small>R̄：三局的样本均值，只是粗估。</T></div><div><T small tone="accent">③ 按当前策略玩很多局 → 期望</T><F latex={String.raw`J(\theta)=\mathbb{E}_{\pi_\theta}[R]`}/><T small>E：期望；J：要提高的平均表现。</T></div></div></div></Page>;}

export function ObjectiveGradientLesson(){const[q,setQ]=useState(50);const mean=5*q/100+3*(1-q/100);return <Page title="怎样让高分路线更常出现？" subtitle="先用一个只含两条路线的简化例子，观察概率怎样影响平均得分。" takeaway="更常走高分路线 → 平均得分更高。接下来：权重该怎样改？"><div className="pg-tr-probability-experiment"><div className="pg-tr-probability-routes">{goalPaths.slice(0,2).map((route,i)=><div key={i}><H>{i===0?'短路线 · 5 分':'绕路 · 3 分'}</H><Board cell={GOAL} steps={route}/><div className="pg-tr-route-frequency"><T small>出现概率</T><H>{i===0?q:100-q}%</H></div></div>)}<div className="pg-tr-probability-result"><H>平均得分</H><F latex={String.raw`J(\theta)=${mean.toFixed(2)}`}/><div className="pg-tr-frequency-bar" role="img" aria-label={`短路线 ${q}%，绕路 ${100-q}%`}><span style={{width:`${q}%`}}/><span style={{width:`${100-q}%`}}/></div><F latex={String.raw`${(q/100).toFixed(2)}\times5+${(1-q/100).toFixed(2)}\times3`}/><T small>两条路线的得分没变，改变的是出现概率。</T></div></div><div className="pg-tr-route-slider"><RangeControl label={`短路线出现概率：${q}%`} min={0} max={100} step={5} value={q} onChange={e=>setQ(Number(e.target.value))}/><T small tone="muted">滑块模拟路线概率；训练实际改的是网络权重。</T></div><div className="pg-tr-probability-chain">{['调整权重 θ','每步动作概率 πθ','路线概率 Pπθ','平均得分 J'].map((v,i)=><div key={v}><T small>{v}</T>{i<3&&<T tone="accent">→</T>}</div>)}</div></div></Page>;}

export function GradientAscentLesson(){return <Page title="目标更高，权重该往哪里改？" subtitle="目标已确定：提高期望回报。现在寻找调整权重的方向。" takeaway="梯度给方向，学习率给步长。下一页：这个梯度怎样算？"><div className="pg-tr-ascent"><div className="pg-tr-ascent-goal"><H>训练目标</H><F latex={String.raw`\max_\theta J(\theta)`}/><T small>θ 是策略网络权重；J 是按该策略行动的期望回报。</T></div><div className="pg-tr-ascent-flow">{[['当前权重','θold'],['梯度给调整方向','∇θJ'],['得到新权重','θnew']].map((v,i)=><div key={v[0]}><H>{v[0]}</H><T>{v[1]}</T>{i<2&&<T tone="accent">→</T>}</div>)}</div><F latex={String.raw`\theta_{\mathrm{new}}=\theta_{\mathrm{old}}+\alpha\,\nabla_\theta J(\theta_{\mathrm{old}})`}/><div className="pg-tr-ascent-key"><T small>∇θJ：对权重求梯度，指出局部提高目标的方向。</T><T small>α：学习率，控制每次调整的幅度。</T><T small>＋：梯度上升；实际训练使用采样估计。</T></div></div></Page>;}

// Conditional Monte Carlo evaluation at the fixed second decision (t=1).
// The first action is conditioned to be Right; the remaining actions follow the unchanged policy.
interface MCSample { path:Step[]; score:number }
function sampleActionValue(seed:number):{sample:MCSample;seed:number}{let cell=A;const steps:Step[]=[];for(let k=0;k<29;k++){const p=forward(DEMO,cell).p;let action=3;if(k>0){let u;[u,seed]=random(seed);action=0;while(action<3&&u>=p[action]){u-=p[action];action++;}}const result=transition(cell,DIRECTIONS[action]);steps.push({state:cell,action:DIRECTIONS[action],probability:p[action],...result});cell=result.next;if(result.terminal)break;}return {sample:{path:steps,score:returns(steps)[0]},seed};}
function initialMCView(){let seed=9817,total=0;const recent:MCSample[]=[];for(let i=0;i<20;i++){const result=sampleActionValue(seed);seed=result.seed;recent.push(result.sample);total+=result.sample.score;}return {seed,total,n:20,recent:recent.slice(-3)};}
export function ActionValueMCLesson(){const[mc,setMC]=useState(initialMCView),[pick,setPick]=useState(2);const selected=mc.recent[pick]??mc.recent.at(-1)!;const prefix=DEMO_PATH[0];const add=(count:number)=>{setMC(old=>{let {seed,total,n}=old;let recent=[...old.recent];for(let i=0;i<count;i++){const result=sampleActionValue(seed);seed=result.seed;total+=result.sample.score;n++;recent=[...recent,result.sample].slice(-3);}return{seed,total,n,recent};});setPick(2);};return <Page title="Q 是平均评价，Gₜ 是一次经历" subtitle="上一页用 Gₜ 评价动作。固定第 2 步向右，多次续走，看看单次回报与平均评价的区别。" takeaway="Q 是同一状态动作下的期望回报；REINFORCE 用实际 Gₜ 作它的蒙特卡洛样本。接下来把采样和更新连成流程。"><div className="pg-tr-scene pg-tr-mc-value"><div className="pg-tr-stack"><Board cell={selected.path.at(-1)!.next} steps={[prefix,...selected.path]} focus={1}/><T small>本次后续回报：{selected.score} · {selected.path.length} 步 · {selected.path.at(-1)!.terminal?'到达终点':'达到本局 30 步上限'}</T><Controls>{mc.recent.map((v,i)=><Button key={mc.n-2+i} active={pick===i} onClick={()=>setPick(i)}>第 {mc.n-2+i} 次 · {v.score} 分</Button>)}</Controls></div><div className="pg-tr-stack"><H>这个动作，平均能得到多少回报？</H><F latex={String.raw`Q_t^\pi(s,a)=\mathbb E_\pi[G_t\mid s_t=s,\ a_t=a]`}/><T small>Q 是动作价值；π 是之后遵循的策略；t 从 0 计，区分剩余步数。</T><div className="pg-tr-mc-contrast"><div><T small>一局提供一个样本</T><H>{selected.score}</H><T small>本次 G₁ · 一次经历</T></div><div><T small>相同条件反复采样</T><H>{(mc.total/mc.n).toFixed(2)}</H><T small>{mc.n} 次回报的均值 · Q₁π 的粗估</T></div></div><Controls><Button variant="primary" onClick={()=>add(1)}>再采样 1 局</Button><Button onClick={()=>add(20)}>采样 20 局</Button></Controls><T small tone="muted">重复续走用于理解 Q；REINFORCE 不要求每步都重复采样。初始策略未训练，常会超时。</T></div></div></Page>;}

export function CriticBridgeLesson(){return <Page title="必须等整局结束，才能评价动作吗？" subtitle="刚才的 REINFORCE 等终局后计算回报。下一步：能否学习一个价值网络来辅助评价？" takeaway="Actor 决定行动，Critic 评估回报。这里只建立联系，下一章再展开 Actor-Critic。"><div className="pg-tr-critic-bridge"><div className="pg-tr-critic-question"><Board cell={A}/><H>向上撞墙：即时奖励 −1</H><T small>REINFORCE 仍要等后续经历，才能知道这一步的 Gₜ。</T></div><div className="pg-tr-critic-options"><div><H>本章：蒙特卡洛回报</H><T>走完整局 → 算出 Gₜ → 更新策略</T><T small>用实际经历计算后续回报；单局有噪声。</T></div><div><H>下一章：学一个评价者</H><T>价值网络 → 估计回报 → 辅助策略更新</T><T small>学习预测后续回报，尝试在整局结束前提供评价；具体方法留到下一章。</T></div><T small>价值网络预测回报；环境模型预测下一状态与奖励，两者含义不同。</T></div></div></Page>;}

export function ObjectiveGradientDerivationLesson(){return <Page title="先看整局：怎样从得分找到梯度？" subtitle="得分由环境给出；权重改变的是路线出现的概率。" takeaway="得分加权概率的梯度。下一页：把整局拆到每一步。"><div className="pg-tr-theory-detail"><div className="pg-tr-derive-legend"><T small>τ：整局轨迹</T><T small>Pπθ(τ)：策略产生这条轨迹的概率</T><T small>R(τ)：该路线得分</T></div><div className="pg-tr-derive-columns"><div><H>① 概率 × 得分</H><F latex={String.raw`J(\theta)=\sum_\tau P_{\pi_\theta}(\tau)R(\tau)`}/><T small>Στ：遍历所有可能轨迹。</T></div><div><H>② 对权重求导</H><F latex={String.raw`\nabla_\theta J=\sum_\tau R(\tau)\nabla_\theta P_{\pi_\theta}(\tau)`}/><T small>固定轨迹得分不变，只对概率求导。</T></div><div><H>③ 改写为 log 梯度</H><F latex={String.raw`\nabla_\theta P=P\,\nabla_\theta\log P`}/><T small>log：自然对数；P 简写轨迹概率。这是链式法则。</T></div></div><div className="pg-tr-derive-result"><F latex={String.raw`\nabla_\theta J=\mathbb E_{\tau\sim P_{\pi_\theta}}[R(\tau)\nabla_\theta\log P_{\pi_\theta}(\tau)]`}/><T small>E：期望；τ ∼ Pπθ：按当前策略采样轨迹。</T></div></div></Page>;}

export function TrajectoryGradientLesson(){const[t,setT]=useState(2);const step=path[t];return <Page title="这一步，得到什么学习信号？" subtitle="已收集六步经历、算出各步回报。现在把这些数代入梯度式；点击时间轴查看每步的贡献。" takeaway="ĝ 是用这一局得到的梯度估计；下一页把同一规则写成损失，交给反向传播更新权重。"><div className="pg-tr-experience-signal"><div className="pg-tr-signal-scene"><div className="pg-tr-stack"><Board cell={GOAL} steps={path} focus={t}/><T small>回看第 {t+1} 步：向{DIR_LABEL[step.action]} · 橙框标记当时位置</T><T small>网络当时给所选动作的概率：{pct(step.probability)}</T></div><div className="pg-tr-trajectory-reward"><H>这一步之后，发生了什么？</H><div className="pg-tr-reward-timeline">{path.map((v,i)=><Button key={i} active={t===i} className={i<t?'is-past':'is-future'} onClick={()=>setT(i)}><T small>第 {i+1} 步</T><H>{ARROW[v.action]} {v.reward>0?'+10':'−1'}</H></Button>)}</div><div className="pg-tr-time-key"><T small tone="muted">淡色：过去</T><T small tone="accent">蓝色：计入本步回报</T></div><F latex={String.raw`G_{${t}}=${path.slice(t).map(v=>v.reward===10?'+10':'-1').join('')}=${gains[t]}`}/><T small>Gₜ 是本步到终局的奖励之和；走完一局再相加，就是蒙特卡洛回报。</T></div></div><div className="pg-tr-signal-rule"><F latex={String.raw`\widehat g=\sum_t\underbrace{G_t}_{\text{后续回报}}\underbrace{\nabla_\theta\log\pi_\theta(a_t\mid s_t)}_{\text{权重调整方向}}`}/><div><T small>ĝ：一局的梯度估计。Gₜ 是已算出的回报；log 概率的梯度由旧网络反向传播得到；Σ 合并各步贡献。</T></div></div></div></Page>;}

export function TrajectoryGradientDerivationLesson(){return <Page title="再看每步：概率和回报怎样拆开？" subtitle="sₜ 是位置，aₜ 是动作；t 从 0 计，T 为本局步数。本章 γ = 1。" takeaway="后续回报给每步梯度加权；接下来用采样的一局估计它。"><div className="pg-tr-gradient-bridge"><T small tone="accent">把上一页的整局梯度拆开</T><div className="pg-tr-theory-pair"><div><H>① 整局概率 → 每步概率</H><T small>轨迹概率来自每步动作概率的连乘。</T><F latex={String.raw`\nabla_\theta\log P_{\pi_\theta}(\tau)=\sum_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)`}/><T small>log 把连乘变求和；固定环境项对 θ 的梯度为 0。</T></div><div><H>② 整局得分 → 后续回报</H><T small>Gₜ：本步起的奖励之和；rₜ：本步奖励。</T><F latex={String.raw`G_t=r_t+r_{t+1}+\cdots+r_{T-1}`}/><T small>动作不能改变过去；过去奖励的梯度项期望为 0，所以只留后续回报。</T></div></div><div className="pg-tr-derive-result"><T small tone="accent">代回上一页：各步相加，再取期望</T><F latex={String.raw`\nabla_\theta J=\mathbb E_{\tau\sim P_{\pi_\theta}}\left[\sum_tG_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)\right]`}/><T small>∇θlogπθ(aₜ|sₜ)：提高所选动作概率的权重方向；Gₜ：加权信号。</T></div></div></Page>;}

export function OptimizationLesson(){const p=forward(DEMO,A).p[3];return <Page title="把回报变成神经网络的训练损失" subtitle="各步回报已算好。接下来构造损失 L，让反向传播算出前面的回报加权梯度。" takeaway="负号把策略梯度上升，接成深度学习常用的损失下降。下一页再实际修改权重、重算概率。"><div className="pg-tr-scene pg-tr-reason pg-tr-update-map"><div className="pg-tr-stack"><Board cell={A}/><T small>回看第 2 步：在这个位置选择向右</T><div className="pg-tr-output-change"><T>旧网络：向右概率 {pct(p)}</T><T>这次经历：后续回报 G₁ = 6</T><T small tone="muted">这里仍然使用采样时的旧权重。</T></div></div><div className="pg-tr-update-stages"><div><H>① 给这次选择一个损失</H><F latex={String.raw`L_t=-G_t\log\pi_\theta(a_t\mid s_t)`}/><T small>Gₜ 为正时，所选动作概率越大，这一项损失越小；负回报时方向相反。</T></div><div><H>② 合并一局，反向传播</H><F latex={String.raw`L=\sum_tL_t`}/><div className="pg-tr-backprop-chain">{['损失 L','动作概率','第二层 W₂','第一层 W₁'].map((v,i)=><div key={v}><T small>{v}</T>{i<3&&<T tone="accent">→</T>}</div>)}</div><T small>Gₜ 是经历提供的常数；梯度传回两层网络权重。</T></div><div><H>③ 为什么损失前面加负号？</H><F latex={String.raw`\nabla_\theta L=-\widehat g`}/><T small>ĝ 是第 9 页的一局梯度估计。减去损失梯度，等价于加上策略梯度估计。</T></div></div></div></Page>;}

const path=DEMO_PATH, gains=returns(path), aProbs=forward(DEMO,A).p;
const pct=(v:number)=>`${(100*v).toFixed(1)}%`;
const n=(v:number)=>v.toFixed(3);
function Board({cell=START,steps=[],visible=steps.length,focus=-1,onSelect}:{cell?:number;steps?:Step[];visible?:number;focus?:number;onSelect?:(cell:number)=>void}){return <div className="pg-tr-board"><MazeBoard position={cell} steps={steps} visible={visible} focus={focus} fox showPath onSelect={onSelect}/></div>}
function Outputs({p,old,digits=1}:{p:number[];old?:number[];digits?:number}){return <div className="pg-tr-outputs">{DIRECTIONS.map((d,i)=><div key={d}><T small>{ARROW[d]} {DIR_LABEL[d]}</T><H>{(p[i]*100).toFixed(digits)}%</H>{old&&<><T small tone="muted">原来 {(old[i]*100).toFixed(digits)}%</T><T small tone="accent">{Math.abs((p[i]-old[i])*100)<.0005?(p[i]>=old[i]?'微小上升':'微小下降'):`${p[i]>=old[i]?'+':''}${((p[i]-old[i])*100).toFixed(3)} 百分点`}</T></>}</div>)}</div>}
function Steps({active,onSelect}:{active:number;onSelect:(i:number)=>void}){return <Controls>{path.map((s,i)=><Button key={i} active={active===i} onClick={()=>onSelect(i)}>{i+1} {ARROW[s.action]}{s.wall?'×':''}</Button>)}</Controls>}
function Next({step,max,set}:{step:number;max:number;set:(s:number)=>void}){return <Controls><Button disabled={step===0} onClick={()=>set(step-1)}>上一步</Button><Button variant="primary" disabled={step===max} onClick={()=>set(step+1)}>下一步 →</Button><Button onClick={()=>set(0)}>重播</Button></Controls>}

export function ModelLesson(){const[cell,setCell]=useState(A);const f=forward(DEMO,cell);return <Page title="用神经网络决定行动" subtitle="当前位置 → 隐藏层 → 动作分数 → softmax → 动作概率" takeaway="θ 统称两层权重 W₁、W₂，共 160 个参数；训练就是调整 θ。"><div className="pg-tr-scene pg-tr-model"><div className="pg-tr-stack"><Board cell={cell} onSelect={c=>{if(c!==GOAL)setCell(c);}}/><T small tone="muted">当前位置：第 {Math.floor(cell/4)+1} 行，第 {cell%4+1} 列 · 可点击格子</T></div><div className="pg-tr-stack"><T small>位置编码 x：第 {cell+1} 位为 1，其余为 0</T><div className="pg-tr-onehot pg-tr-onehot-row">{Array.from({length:16},(_,i)=><div key={i} className={i===cell?'is-active':''}><T small>{i===cell?'1':'0'}</T></div>)}</div><div className="pg-tr-aligned-net"><div className="pg-tr-aligned-head"><T small>输入 x · 16</T><T small>隐藏 h · 8</T><T small>分数 z · 4</T><T small>softmax</T><T small>概率 πθ</T></div><div className="pg-tr-aligned-body"><svg viewBox="0 0 800 280" preserveAspectRatio="none" role="img" aria-label="位置编码经两层权重得到动作分数，再经softmax得到动作概率">{Array.from({length:16},(_,i)=>Array.from({length:8},(_,j)=><line key={`a${i}-${j}`} x1="48" y1={20+i*16} x2="248" y2={28+j*32} stroke={i===cell?'#dd9a47':'#b5c8d9'} strokeWidth={i===cell?1.6:.7} opacity={i===cell?.8:.3}/>))}{Array.from({length:8},(_,j)=>Array.from({length:4},(_,k)=><line key={`b${j}-${k}`} x1="248" y1={28+j*32} x2="448" y2={56+k*56} stroke="#7395af" strokeWidth="1" opacity=".45"/>))}</svg>{Array.from({length:16},(_,i)=><span key={`x${i}`} aria-hidden="true" className={`pg-tr-neuron is-input ${i===cell?'is-active':''}`} style={{left:'6%',top:`${(20+i*16)/280*100}%`}}/>)}{f.h.map((_,j)=><span key={`h${j}`} aria-hidden="true" className="pg-tr-neuron is-hidden" style={{left:'31%',top:`${(28+j*32)/280*100}%`}}/>)}{f.z.map((_,k)=><span key={`z${k}`} aria-hidden="true" className="pg-tr-neuron is-output" style={{left:'56%',top:`${(56+k*56)/280*100}%`}}/>)}<div className="pg-tr-aligned-scores">{f.z.map((v,i)=><T small key={i}>{n(v)}</T>)}</div><div className="pg-tr-aligned-softmax"><T tone="accent">→</T><T small>归一化</T></div><div className="pg-tr-aligned-probs">{DIRECTIONS.map((d,i)=><div key={d}><T small>{ARROW[d]} {DIR_LABEL[d]}</T><T small tone="accent">{pct(f.p[i])}</T></div>)}</div></div></div><div className="pg-tr-equation-pair"><div><F latex={String.raw`h=\tanh\!\left(W_1x\right)`}/><T small>W₁：位置 x → 隐藏表示 h；tanh 加入非线性。</T></div><div><F latex={String.raw`z=W_2h`}/><T small>W₂：隐藏 h → 分数 z；softmax 转成和为 1 的概率。</T></div></div></div></div></Page>}

export function ReinforceIntroLesson(){return <Page title="REINFORCE：把一局经历变成一次更新" subtitle="用一局实际经历，估计策略梯度的更新方向。" takeaway="采样一局 → 算回报 → 更新一次 → 用新策略再采样。"><div className="pg-tr-reinforce-intro"><H>蒙特卡洛：用实际采样估计期望</H><div className="pg-tr-reinforce-intro-cards"><div><T small>① 收集经历</T><H>πθ → τ</H><T small>按当前策略走完整局；τ 记录位置、动作、奖励。</T></div><div><T small>② 评价选择</T><H>τ → Gₜ</H><T small>等终局后，计算每一步之后的实际回报。</T></div><div><T small>③ 更新策略</T><H>Gₜ → θnew</H><T small>用回报加权各步梯度，合并后更新权重。</T></div></div><div className="pg-tr-derive-result"><T small tone="accent">从期望梯度，到一局估计</T><F latex={String.raw`\widehat g=\sum_{t=0}^{T-1}G_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)`}/><T small>ĝ：本局梯度估计；T：本局步数。单局会有波动，需要反复采样。</T></div></div></Page>;}

function TrainingProgress({active}:{active:number}){return <div className="pg-tr-training-progress" role="list" aria-label="REINFORCE 训练流程">{['① 采样一局','② 计算回报','③ 更新网络','↻ 用新网络重复'].map((label,i)=><div key={label} role="listitem" aria-current={i===active?'step':undefined} className={i===active?'is-current':''}><T small>{label}</T></div>)}</div>}

export function RolloutLesson(){const[k,setK]=useState(0),[phase,setPhase]=useState(0);const done=k===path.length,s=path[Math.min(k,path.length-1)],p=forward(DEMO,s.state).p;const next=()=>{if(phase<2)setPhase(phase+1);else{setK(k+1);setPhase(0);}};const completed=k+(phase===2?1:0);return <Page title="REINFORCE 第一步：采样一局" subtitle="区间越宽，越容易抽中；每次不一定选最大概率。" takeaway="采样只收集经历；整局结束后，再计算回报并更新网络。"><div className="pg-tr-case-wrap pg-tr-sampling-lesson pg-tr-visual-sampling"><TrainingProgress active={0}/><div className="pg-tr-scene"><div className="pg-tr-stack pg-tr-sampling-left"><Board cell={done?GOAL:phase===2?s.next:s.state} steps={path} visible={completed}/><div className="pg-tr-strip">{path.map((v,i)=><div key={i}><T small>{i+1}</T><H>{i<completed?ARROW[v.action]:'·'}</H><T small>{i<completed?v.reward:'待采样'}</T></div>)}</div></div><div className="pg-tr-stack pg-tr-sampling-right"><H>{done?'已到终点，一局完成':`第 ${k+1} 步 · ${['看概率','抽方向','走一步'][phase]}`}</H>{done?<><H>6 条经验已保存</H><T>下一页：计算各步回报 → 更新网络</T></>:<><div className="pg-tr-draw-scale"><div className="pg-tr-draw-bar" role="img" aria-label={phase===0?'上、下、左、右的概率区间':`随机数 ${DEMO_DRAWS[k].toFixed(3)} 命中向${DIR_LABEL[s.action]}区间`}>{DIRECTIONS.map((d,i)=><div key={d} className={`pg-tr-draw-segment dir-${i} ${phase>0&&d===s.action?'is-chosen':''}`} style={{width:`${p[i]*100}%`}}><T small>{ARROW[d]} {DIR_LABEL[d]}</T><H>{pct(p[i])}</H></div>)}{phase>0&&<div className="pg-tr-draw-line" style={{left:`${DEMO_DRAWS[k]*100}%`}}/>}</div><div className="pg-tr-draw-ticks"><div style={{left:0}}><T small>0</T></div><div style={{right:0}}><T small>1</T></div></div></div><div className="pg-tr-sampling-facts" aria-live="polite"><div><T small>均匀抽数（0～1）</T><H>{phase>0?DEMO_DRAWS[k].toFixed(3):'—'}</H></div><T tone="accent">→</T><div><T small>选中方向</T><H>{phase>0?`${ARROW[s.action]} ${DIR_LABEL[s.action]}`:'—'}</H></div><T tone="accent">→</T><div><T small>本步奖励</T><H>{phase===2?(s.reward>0?'+10':'−1'):'—'}</H></div></div></>}<Controls><Button variant="primary" onClick={next} disabled={done}>{done?'采样完成':phase===0?'抽一个方向':phase===1?`执行 ${ARROW[s.action]} ${DIR_LABEL[s.action]}`:'再走下一步'}</Button><Button onClick={()=>{setK(0);setPhase(0);}}>重播本局</Button></Controls><T small tone="muted">教学回放：固定抽数。真实训练会重新随机抽数。</T></div></div></div></Page>}

export function ReturnsLesson(){const[i,setI]=useState(path.length-1);const nextReturn=i===path.length-1?0:gains[i+1];return <Page title="走完以后，倒着计算回报" subtitle="从最后一步开始：本步奖励 + 下一步回报 = 本步回报。" takeaway="终局之后 G₆ = 0；γ = 1 时直接相加。倒着算的是回报，狐狸仍停在终点。"><div className="pg-tr-course-wrap"><TrainingProgress active={1}/><div className="pg-tr-scene pg-tr-return-practice"><div className="pg-tr-stack"><Board cell={GOAL} steps={path} focus={i}/><Steps active={i} onSelect={setI}/><T small tone="muted">橙框：当前回看的历史位置</T></div><div className="pg-tr-stack"><H>第 {i+1} 步的回报</H><F latex={String.raw`G_t=r_t+\gamma G_{t+1}`}/><div className="pg-tr-return-calculation"><div><T small>本步奖励 rₜ</T><H>{path[i].reward}</H></div><T>+</T><div><T small>下一步回报 Gₜ₊₁</T><H>{nextReturn}</H></div><T>=</T><div className="is-result"><T small>本步回报 Gₜ</T><H>{gains[i]}</H></div></div><F latex={String.raw`G_{${i}}=${path[i].reward}+${nextReturn}=${gains[i]}`}/><T small>{i===path.length-1?'终局之后的回报为 0，从这里开始往前算。':i===0?'六步回报全部算完；G₀ = 5，也是这一局的总得分。':'下一步的回报已经算好，再加上本步奖励。'}</T><Controls><Button variant="primary" disabled={i===0} onClick={()=>setI(i-1)}>往前算一步 ←</Button><Button onClick={()=>setI(path.length-1)}>从最后一步重播</Button></Controls></div></div></div></Page>}

export function GradientLesson(){return <Page title="REINFORCE：每局结束，更新一次" subtitle="先初始化网络权重 θ，再重复下面一轮；每局开始都使用最新的策略。" takeaway="采样期间权重固定，终局后才更新。接下来用同一条六步经历，依次完成这四步。"><div className="pg-tr-algorithm"><div className="pg-tr-algo-flow">{[['① 采样整局','位置 → 概率 → 动作 → 奖励','保存各步位置、动作和奖励'],['② 倒算回报','从最后一步往前相加','得到每一步的 Gₜ'],['③ 反向传播','回报给所选动作的梯度加权','合并整局贡献'],['④ 更新权重','沿梯度方向调整 θ','用新网络开始下一局']].map(v=><div key={v[0]}><H>{v[0]}</H><T>{v[1]}</T><T small tone="muted">{v[2]}</T></div>)}</div><div className="pg-tr-algorithm-rule"><F latex={String.raw`\theta_{\mathrm{new}}=\theta_{\mathrm{old}}+\alpha\underbrace{\sum_tG_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)}_{\text{一局梯度估计 }\widehat g}`}/><div className="pg-tr-algorithm-legend"><T small>θold / θnew：更新前 / 后权重</T><T small>πθ(aₜ|sₜ)：本步所选动作的概率</T><T small>α：学习率，控制更新步长</T></div></div><div className="pg-tr-training-loop"><T tone="accent">采样 → 回报 → 反向传播 → 更新</T><T small>更新后返回第一步，采一局新经历。</T></div></div></Page>;}

export function NumericUpdateLesson(){const[stage,setStage]=useState(0),[cell,setCell]=useState(A);const u=updateNetwork(DEMO,path),oldP=forward(DEMO,A).p[3];const w=DEMO.w2[3][0],g=-u.g.w2[3][0],newW=u.after.w2[3][0];const choose=(i:number)=>{setStage(i);setCell(A);};return <Page title="跟踪一条权重，看看网络怎样学" subtitle="第 2 步向右，后续回报 6；用整局六步经历更新。" takeaway="策略更新用加号；代码减去负损失的梯度，与它完全等价。"><div className="pg-tr-course-wrap"><TrainingProgress active={2}/><div className="pg-tr-scene pg-tr-numeric pg-tr-one-weight"><div className="pg-tr-stack"><Board cell={cell} steps={path} focus={stage<3?1:-1} onSelect={stage===3?c=>{if(c!==GOAL)setCell(c);}:undefined}/><Outputs p={forward(stage===3?u.after:DEMO,cell).p} old={stage===3?forward(DEMO,cell).p:undefined} digits={2}/><T small>{stage===3?`同一位置的新旧概率 · 可点击格子查看其他位置`:'固定看第 4 行第 2 列：当时选择向右'}</T></div><div className="pg-tr-stack"><Controls>{['损失','梯度','改权重','新概率'].map((v,i)=><Button key={v} active={stage===i} onClick={()=>choose(i)}>{i+1} {v}</Button>)}</Controls><H>{['① 让有回报的选择更常出现','② 计算这条权重该往哪边改','③ 沿提高回报的方向，加一小步','④ 同一位置，重新经过网络'][stage]}</H>{stage===0?<><div className="pg-tr-example-pair"><div><T small>本步后续回报 G₁</T><H>6</H></div><div><T small>旧网络的向右概率</T><H>{(oldP*100).toFixed(2)}%</H></div></div><F latex={String.raw`L_1=-6\log(${oldP.toFixed(4)})\approx${(-6*Math.log(oldP)).toFixed(3)}`}/><T small>L₁：本步损失。回报为正，所选动作概率越大，损失越小。</T><T small>六步相加，L = {u.loss.toFixed(3)}；回报固定，只对权重求导。</T></>:stage===1?<><div className="pg-tr-weight-connection"><T small>隐藏单元 1</T><T tone="accent">→ w →</T><T small>向右分数</T></div><T small>w 是这条连接的权重。先对损失求梯度，再取相反数，得到提高回报的方向。</T><F latex={String.raw`\widehat g_w=-\frac{\partial L}{\partial w}=${g.toFixed(3)}`}/><T small>ĝw：本局对 w 的策略梯度估计。为正 → 这次增加 w。</T></>:stage===2?<><T small>学习率 α = 0.0003，控制这次改动的大小。</T><F latex={String.raw`w_{\mathrm{new}}=w_{\mathrm{old}}+\alpha\widehat g_w`}/><F latex={String.raw`${w.toFixed(5)}+0.0003\times(${g.toFixed(3)})\approx${newW.toFixed(5)}`}/><T small>加上本局的策略梯度估计；全部权重按各自梯度更新。</T></>:<><div className="pg-tr-weight-connection"><T small>位置</T><T>→</T><T small>新权重</T><T>→</T><T small>softmax 概率</T></div><F latex={String.raw`${(oldP*100).toFixed(2)}\%\longrightarrow${(forward(u.after,A).p[3]*100).toFixed(2)}\%`}/><T small>整局更新后，这个位置向右的概率增加了 {((forward(u.after,A).p[3]-oldP)*100).toFixed(3)} 个百分点。</T><T small>全部权重共同变化，再经网络重算概率。</T></>}<Next step={stage} max={3} set={choose}/></div></div></div></Page>;}

export function NoiseLesson(){const[show,setShow]=useState(false);return <Page title="撞墙了，为什么还可能被鼓励？" subtitle="换一条轨迹：向上撞墙后，仍然到达了终点。" takeaway="REINFORCE 看后续总回报。单次经历有噪声，需要多次尝试。"><div className="pg-tr-scene"><div className="pg-tr-stack"><Board cell={A}/><H>第 2 步（t = 1）撞墙：奖励 −1</H><T small>新轨迹：右 → 上× → 右 → 上 → 上 → 上 → 右</T></div><div className="pg-tr-stack"><H>从撞墙开始，后续回报是多少？</H><F latex={String.raw`G_1=-1-1-1-1-1+10=5`}/><Button variant="primary" onClick={()=>setShow(!show)}>{show?'收起解释':'这会怎样影响更新？'}</Button>{show&&<><T>回报为正，这条经验可能让“向上”的概率增加。</T><T small>它只看到了“后来成功了”，并不知道撞墙是多余的一步。还需要其他经历来修正。</T></>}</div></div></Page>;}

const codeStages=[
 {name:'前向计算',code:'x = one_hot(state, 16)\nh = tanh(W1 @ x)\nz = W2 @ h\nprobs = softmax(z)',text:'@ 表示矩阵乘法。位置编码依次得到隐藏表示、动作分数和四个概率。'},
 {name:'采样与记录',code:'dist = Categorical(probs)\naction = dist.sample()\nlog_probs.append(dist.log_prob(action))\nstate, reward, done = maze.step(action)\nrewards.append(reward)',text:'Categorical 建立四方向分布；sample 抽动作，log_prob 记录其 log 概率。交互到终局。'},
 {name:'计算损失',code:'G = reward_to_go(rewards)\nloss = -sum(g * logp\n            for g, logp in zip(G, log_probs))',text:'G 保存各步回报，log_probs 保存所选动作的 log 概率；对应相乘、求和，再取负号组成 loss。'},
 {name:'反向传播与更新',code:'optimizer.zero_grad()\nloss.backward()\noptimizer.step()',text:'清除旧梯度，反向传播计算本局梯度，再让优化器更新权重。下一局使用新参数。'}];
export function LossLesson(){const[i,setI]=useState(0);return <Page title="把算法接到神经网络训练代码" subtitle="模型有输入、参数、输出和损失；特别之处是学习信号来自交互回报。" takeaway="用当前策略的新经历更新一次。判断是否学好，要看平均回报，不看损失大小。"><div className="pg-tr-scene"><div className="pg-tr-stack"><Controls>{codeStages.map((v,j)=><Button key={v.name} active={i===j} onClick={()=>setI(j)}>{j+1} {v.name}</Button>)}</Controls><pre className="pg-tr-code">{codeStages[i].code}</pre><T>{codeStages[i].text}</T></div><div className="pg-tr-stack"><F latex={String.raw`L(\theta)=-\sum_{t=0}^{T-1}G_t\log\pi_\theta(a_t\mid s_t)`}/><T small>L 用于计算梯度，不是策略得分；Gₜ 视为采样常数，不对它求导。</T><F latex={String.raw`\theta' = \theta-\alpha\nabla_\theta L`}/><T>整局损失的梯度 ∇θL = −ĝ；减去它，等价于 REINFORCE 的加号更新。</T><T small tone="muted">公式是单局求和版；代码为 PyTorch 风格伪代码，真实训练页使用同一网络的等价数值实现。</T></div></div></Page>}

export function TrainingCurve({scores}:{scores:number[]}){if(!scores.length)return <div className="pg-tr-curve-empty"><T small tone="muted">训练后显示平均回报曲线</T></div>;const points:{x:number;y:number}[]=[];for(let end=1;end<=scores.length;end++){if(end%20!==0&&end!==scores.length)continue;const window=scores.slice(Math.max(0,end-100),end);const mean=window.reduce((a,b)=>a+b,0)/window.length;points.push({x:scores.length===1?0:(end-1)/Math.max(1,scores.length-1)*600,y:6+(5-mean)/35*62});}const d=points.map((p,i)=>`${i?'L':'M'}${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');return <div className="pg-tr-training-curve"><div><T small>+5</T><T small>−30</T></div>{scores.length?<svg viewBox="0 0 600 74" role="img" aria-label="真实训练记录的最近100局平均回报曲线；不足100局时使用已有局数"><path d="M0 6H600M0 68H600" fill="none" stroke="#c7d5df" strokeWidth="1"/><path d={d} fill="none" stroke="#315b7b" strokeWidth="3"/>{points.length===1&&<circle cx={points[0].x} cy={points[0].y} r="4" fill="#315b7b"/>}</svg>:<T small tone="muted">训练后显示平均回报曲线</T>}</div>;}

interface EpisodeRecord { number:number; before:Network; after:Network; path:Step[]; seed:number }
function realEpisode(run:NeuralRun):{record:EpisodeRecord;run:NeuralRun}{const[path,seed]=episode(run.network,run.seed);const {after}=updateNetwork(run.network,path);return {record:{number:run.episodes+1,before:run.network,after,path,seed},run:{network:after,seed,episodes:run.episodes+1,returns:[...run.returns,returns(path)[0]],last:path}};}
const BASELINE_TRAJECTORY:Step[]=(()=>{let state=START;return (['R','U','R','U','U','U','R'] as const).map(action=>{const probability=forward(DEMO,state).p[DIRECTIONS.indexOf(action)],result=transition(state,action),step={state,action,probability,...result};state=result.next;return step;});})();
export function BaselineLesson(){const[baseline,setBaseline]=useState(5.5);const actual=returns(BASELINE_TRAJECTORY)[1],signal=actual-baseline;return <Page title="选读 · Baseline：比参考表现好多少？" subtitle="两种方法都能加入基线。这里用 REINFORCE 的实际回报举例。" takeaway="同一状态的动作共用基线，求策略梯度时固定它；合适的基线可减小波动。"><div className="pg-tr-scene pg-tr-baseline-bridge"><div className="pg-tr-stack"><Board cell={GOAL} steps={BASELINE_TRAJECTORY} focus={1}/><H>回看第 2 步：向上撞墙</H><T small>本步奖励 −1，但后来成功，后续回报仍为正。</T><F latex={String.raw`G_1=-1-1-1-1-1+10=${actual}`}/></div><div className="pg-tr-stack"><H>学习信号 = 实际回报 − 基线</H><div className="pg-tr-baseline-values"><div><T small>实际回报 G₁</T><H>{actual}</H></div><T>−</T><div><T small>参考回报 b(sₜ)</T><H>{baseline.toFixed(1)}</H></div><T>=</T><div className="is-result"><T small>本条经验的信号</T><H>{signal>0?'+':''}{signal.toFixed(1)}</H></div></div><RangeControl label={`调节参考回报：${baseline.toFixed(1)}`} min={-5} max={10} step={.5} value={baseline} onChange={e=>setBaseline(Number(e.target.value))}/><T small tone="muted">b(sₜ)：该位置共用的参考回报。滑块手动设定，不是训练结果。</T><F latex={String.raw`G_1-b(s_1)=${actual}-\left(${baseline.toFixed(1)}\right)=${signal.toFixed(1)}`}/><T tone="accent">{signal>0?'高于基线：本条经验鼓励这次选择。':signal<0?'低于基线：本条经验抑制这次选择。':'等于基线：本条经验不给策略梯度贡献。'}</T><T small>REINFORCE 用 Gₜ − b(sₜ)；本节 Q 型 Actor-Critic 可用 q − b。</T></div></div></Page>;}

export function LiveTrainingLesson(){
 const[initialNetwork,setInitialNetwork]=useState<Network>(()=>newNeuralRun().network),[run,setRun]=useState<NeuralRun>(()=>newNeuralRun()),[records,setRecords]=useState<EpisodeRecord[]>([]),[inspection,setInspection]=useState<EpisodeRecord|null>(null),[busy,setBusy]=useState(false),[t,setT]=useState(0),[cell,setCell]=useState(START);
 const record=inspection??records.at(-1),trajectory=record?.path??[],stepIndex=Math.min(t,Math.max(0,trajectory.length-1)),selected=trajectory[stepIndex],gs=returns(trajectory),after=record?.after??run.network;
 const window=run.returns.slice(-100),mean=window.length?window.reduce((a,b)=>a+b,0)/window.length:null;
 const train=async(count:number)=>{setBusy(true);setInspection(null);setT(0);setCell(START);let current=run,recent=[...records];for(let completed=0;completed<count;completed+=100){for(let i=0;i<Math.min(100,count-completed);i++){const result=realEpisode(current);current=result.run;recent=[...recent,result.record].slice(-3);}setRun(current);setRecords(recent);await new Promise<void>(resolve=>setTimeout(resolve,0));}setBusy(false);};
 const reset=()=>{const fresh=newNeuralRun();setInitialNetwork(fresh.network);setRun(fresh);setRecords([]);setInspection(null);setT(0);setCell(START);};
 return <Page title="反复训练，看看策略是否学好了" subtitle="重复“采样 → 回报 → 更新”，每局都用新策略采样。这里观察训练结果。" takeaway="看多局平均回报是否提高；单局有波动，训练损失不能代替策略表现。γ=1，每局最多30步。"><div className="pg-tr-course-wrap"><TrainingProgress active={3}/><div className="pg-tr-scene pg-tr-flow-live pg-tr-training-dashboard"><div className="pg-tr-stack"><Board cell={trajectory.at(-1)?.next??START} steps={trajectory} focus={selected?stepIndex:-1} onSelect={c=>{if(c!==GOAL)setCell(c);}}/><T small>{record?`${inspection?'回看':'最近'}第 ${record.number} 局 · ${trajectory.length} 步 · 得分 ${gs[0]}`:'训练后，这里显示实际走过的路线。'}</T>{selected&&<><RangeControl label={`回看第 ${stepIndex+1} 步：向${DIR_LABEL[selected.action]}`} min={1} max={trajectory.length} step={1} value={stepIndex+1} onChange={e=>{const index=Number(e.target.value)-1;setT(index);setCell(trajectory[index].state);}}/><div className="pg-tr-dashboard-return"><F latex={String.raw`G_{${stepIndex}}=${selected.reward}+${stepIndex===trajectory.length-1?0:gs[stepIndex+1]}=${gs[stepIndex]}`}/></div></>}<div className="pg-tr-records" aria-label="最近三条实际训练轨迹"><Controls>{records.map(r=><Button key={r.number} disabled={busy} active={record===r} onClick={()=>{setInspection(r);setT(0);setCell(r.path[0].state);}}>{r.number} 局 · {returns(r.path)[0]} 分</Button>)}</Controls></div></div><div className="pg-tr-stack pg-tr-flow-right"><div className="pg-tr-dashboard-metrics"><H>已训练 {run.episodes} 局</H><T small>近 {window.length||100} 局均分：{mean===null?'—':mean.toFixed(2)}</T></div><TrainingCurve scores={run.returns}/><T small tone="accent">第 {Math.floor(cell/4)+1} 行第 {cell%4+1} 列 · 初始策略 → {record?`第 ${record.number} 局训练后`:'尚未训练'}</T><div className="pg-tr-outputs pg-tr-live-probs">{DIRECTIONS.map((d,i)=><div key={d}><T small>{ARROW[d]} {DIR_LABEL[d]}</T><T small>初始 {(forward(initialNetwork,cell).p[i]*100).toFixed(2)}%</T><T small tone="accent">训练后 {(forward(after,cell).p[i]*100).toFixed(2)}%</T></div>)}</div><div className="pg-tr-live-actions"><Controls><Button variant="primary" disabled={busy} onClick={()=>train(1)}>训练 1 局</Button><Button disabled={busy} onClick={()=>train(100)}>训练 100 局</Button></Controls><Controls><Button disabled={busy} onClick={()=>train(1000)}>{busy?'训练中…':'训练 1000 局'}</Button><Button disabled={busy} onClick={reset}>重置</Button></Controls></div></div></div></div></Page>;
}
