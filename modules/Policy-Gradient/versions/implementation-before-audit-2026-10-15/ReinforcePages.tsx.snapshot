import { useEffect, useState } from 'react';
import { Button, RangeControl } from '../../shared/react';
import { Controls, F, H, Page, T } from '../components/LessonVisuals';
import { ARROW, MazeBoard, MazeGame } from '../components/ReinforceMaze';
import { A, DIRECTIONS, DIR_LABEL, format, GOAL, initialPolicy, mcUpdates, newTrain, percent, probabilities, REFERENCE, REFERENCE_DRAWS, returns, START, WALLS, train, transition, type Direction, type TrainState } from '../mazeModel';

const reference = REFERENCE;
const rewards = returns(reference);
const policy = initialPolicy();
const initialA = probabilities(policy[A]);
const updatedA = mcUpdates(reference).find(update => update.state === A)!;
const draws = REFERENCE_DRAWS;
const qValues: Record<Direction, number> = { U: 5, D: 5, L: 4, R: 6 };

function Tag({ children }: { children: React.ReactNode }) { return <div className="pg-re-eyebrow"><T small tone="accent">{children}</T></div>; }
function Metric({ label, value, active = false }: { label: string; value: string; active?: boolean }) { return <div className={`pg-re-metric ${active ? 'is-active' : ''}`}><T small tone="muted">{label}</T><H>{value}</H></div>; }
function Probabilities({ probs = initialA, picked, precise = false }: { probs?: number[]; picked?: Direction; precise?: boolean }) { return <div className="pg-re-compare">{DIRECTIONS.map((direction, i) => <div key={direction} className={picked === direction ? 'is-picked' : ''}><T small tone="muted">{ARROW[direction]} {DIR_LABEL[direction]}</T><H>{precise ? percent(probs[i]) : `${Math.round(probs[i] * 100)}%`}</H></div>)}</div>; }
function ParameterChange({ after }: { after: number[] }) { return <div className="pg-re-compare">{DIRECTIONS.map((direction, i) => <div key={direction}><T small tone="muted">z{ARROW[direction]}</T><T small>{policy[A][i].toFixed(3)} → {after[i].toFixed(3)}</T></div>)}</div>; }
function Meter({ probs = initialA }: { probs?: number[] }) { return <div className="pg-re-meter" role="img" aria-label={`上 ${percent(probs[0])}，下 ${percent(probs[1])}，左 ${percent(probs[2])}，右 ${percent(probs[3])}`}>{probs.map((prob, i) => <span key={i} className={['up', 'down', 'left', 'right'][i]} style={{ width: `${prob * 100}%` }} />)}</div>; }
function Timeline({ visible = 7, selected = -1, onSelect, showReturns = false }: { visible?: number; selected?: number; onSelect?: (index: number) => void; showReturns?: boolean }) { return <div className="pg-re-timeline" role="group" aria-label="七步采样轨迹">{reference.map((step, index) => <button key={index} type="button" disabled={index >= visible || !onSelect} onClick={() => onSelect?.(index)} className={`${selected === index ? 'is-active' : ''} ${step.wall ? 'is-wall' : ''}`}><T small tone="muted">{index + 1}</T><H>{index < visible ? ARROW[step.action] : '·'}</H><T small>{index < visible ? (showReturns ? `G=${rewards[index]}` : step.reward > 0 ? '+10' : '−1') : '待采样'}</T></button>)}</div>; }
function Code({ active = -1 }: { active?: number }) { const lines = [
  'rewards, log_probs = [], []',
  'state = one_hot(position, 16)',
  'probs = policy_net(state)       # softmax',
  'dist = Categorical(probs)',
  'action = dist.sample(); log_probs.append(dist.log_prob(action))',
  'next_state, reward, done = maze.step(action); rewards.append(reward)',
  'returns = reward_to_go(rewards)',
  'loss = -sum(G * logp for G, logp in zip(returns, log_probs))',
  'optimizer.zero_grad()',
  'loss.backward(); optimizer.step()',
]; return <div className="pg-re-code" aria-label="REINFORCE 示例代码">{lines.map((line, i) => <div key={line} className={`pg-re-code-line ${active === i ? 'is-active' : ''}`}><span>{i + 1}</span><span>{line}</span></div>)}</div>; }

const mazeDistances = (() => {
  const distances: Record<number, number> = { [GOAL]: 0 };
  const queue = [GOAL];
  while (queue.length) { const cell = queue.shift()!; for (const d of DIRECTIONS) { const r=Math.floor(cell/4)+(d==='U'?-1:d==='D'?1:0), c=cell%4+(d==='L'?-1:d==='R'?1:0), next=r*4+c; if(r>=0&&r<4&&c>=0&&c<4&&!WALLS.includes(next)&&distances[next]===undefined) { distances[next]=distances[cell]+1;queue.push(next); } } }
  return distances;
})();
export function ValuePolicyPage() {
  const [mode, setMode] = useState<'value'|'policy'>('value');
  const [hovered, setHovered] = useState<Direction|null>(null);
  const [cell, setCell] = useState(START);
  const [feedback, setFeedback] = useState('点击迷宫中的格子，换个位置试试');
  const [picked, setPicked] = useState<Direction | null>(null);
  const values = DIRECTIONS.map(d => { if(cell===GOAL) return 0; const next=transition(cell,d); return next.terminal ? 10 : 10-mazeDistances[next.next]; });
  const probs = probabilities(values.map(v=>v/2));
  const act = (kind:'value'|'policy', chosen?: Direction) => {
    const outputs=kind==='value'?values:probs;
    const index=chosen ? DIRECTIONS.indexOf(chosen) : outputs.indexOf(Math.max(...outputs));
    const direction=DIRECTIONS[Math.max(0,index)], result=transition(cell,direction);
    setPicked(direction);setCell(result.next);
    setFeedback(`${kind==='value'?'价值方法':'策略方法'}选了 ${ARROW[direction]} ${result.wall?'撞墙，位置不变':result.terminal?'到达宝藏！':'前进一步'}`);
  };
  const candidates = cell===GOAL ? [] : DIRECTIONS.filter((d,i)=>hovered ? d===hovered : values[i]===Math.max(...values)).map(d=>{const r=Math.floor(cell/4)+(d==='U'?-1:d==='D'?1:0),c=cell%4+(d==='L'?-1:d==='R'?1:0);return r>=0&&r<4&&c>=0&&c<4?r*4+c:-1;});
  return <Page scene title="刚才你选方向，现在让模型来选" subtitle="还是这座迷宫。点击位置，切换方法；指向一个方向，看看它对应迷宫中的哪里。" takeaway={mode==='value'?'教学输出示例：价值方法学回报估计，策略方法直接学动作概率。':'策略方法直接输出动作概率。本页选最大概率；训练时再按概率采样。'}>
    <div className="pg-vp-together">
      <div className="pg-vp-map pg-maze-adventure"><MazeBoard position={cell} highlightedCells={candidates} fox facing={picked??'U'} onSelect={next=>{setCell(next);setPicked(null);setFeedback(next===GOAL?'已在终点，选其他位置继续试试':'位置已切换，让模型选下一步');}}/><T tone="accent">{feedback}</T><Button onClick={()=>{setCell(START);setPicked(null);setFeedback('回到起点 S');}}>回到起点 S</Button></div>
      <div className="pg-vp-switch">
        <section className={`pg-vp-dual-lane ${mode==='policy'?'is-policy':''}`}><H>{mode==='value'?'先估计价值，再决定怎么选':'直接输出概率，这就是策略'}</H><div className="pg-vp-dual-numbers">{DIRECTIONS.map((d,i)=><div key={d} role="button" tabIndex={0} aria-label={`查看向${DIR_LABEL[d]}候选动作`} onMouseEnter={()=>setHovered(d)} onMouseLeave={()=>setHovered(null)} onFocus={()=>setHovered(d)} onBlur={()=>setHovered(null)} aria-disabled={cell===GOAL||values[i]!==Math.max(...values)} onKeyDown={event=>{if((event.key==='Enter'||event.key===' ')&&cell!==GOAL&&values[i]===Math.max(...values)){event.preventDefault();act(mode,d);}}} onClick={()=>{setHovered(d);if(cell!==GOAL&&values[i]===Math.max(...values))act(mode,d);}} data-direction={d} className={(hovered===d||(!hovered&&values[i]===Math.max(...values)))?'is-highlighted':''}><T small>{ARROW[d]} {DIR_LABEL[d]}</T><H>{cell===GOAL?'—':mode==='value'?values[i]:`${Math.round(probs[i]*100)}%`}</H></div>)}</div><T small>{mode==='value'?'点击高亮的最大值执行动作；多个方向并列最大时，任选一个。':'本页选择概率最大的方向；并列最大时任选一个。'}</T><Button variant="primary" disabled={cell===GOAL} onClick={()=>act(mode)}>{mode==='value'?'自动选一个最大值':'按最大概率走一步'}</Button></section>
        <div className="pg-vp-transition"><T small tone="accent">{mode==='value'?'能不能直接学习“怎么选”，把动作概率作为模型输出？':'可以：直接学习动作概率，用回报来调整这些概率。'}</T><Controls><Button active={mode==='value'} onClick={()=>{setMode('value');setHovered(null);setCell(START);setPicked(null);setFeedback('回到起点 S，用价值方法试试');}}>价值方法</Button><Button active={mode==='policy'} onClick={()=>{setMode('policy');setHovered(null);setCell(START);setPicked(null);setFeedback('回到起点 S，用策略方法试试');}}>策略方法</Button></Controls></div>
      </div>
    </div>
  </Page>;
}

const introCaptions = [
  'S 是起点；当前位置就是状态。',
  '选择“右”，角色来到 A；普通一步奖励 −1。',
  '在 A 选择“上”，撞到墙：位置不变，仍得 −1。',
  '重新选择“右”，从 A 离开。',
  '沿通道继续前进，每走一步付出 −1。',
  '最后进入 G，得到 +10，本局结束。',
];
export function MazeIntroPage() { const [phase, setPhase] = useState(0), [playing, setPlaying] = useState(true); useEffect(() => { if (!playing || phase >= 5) return; const timer = window.setTimeout(() => setPhase(phase + 1), 1500); return () => window.clearTimeout(timer); }, [phase, playing]); const count = [0, 1, 2, 3, 6, 7][phase]; return <Page title="揭示迷宫规则" subtitle="刚才摸索过的深色砖块就是墙；现在用动画回看移动、撞墙与到达终点。" takeaway="状态＝所在格；动作＝上、下、左、右；撞墙留在原地；到 G 后本局结束。"><div className="pg-re-scene"><MazeBoard steps={reference} visible={count} position={count ? reference[count - 1].next : START} wallFlash={phase === 2} /><div className="pg-re-stack"><Tag>规则动画 · {phase + 1} / 6</Tag><H>{introCaptions[phase]}</H><div className="pg-re-pair"><Metric label="普通一步 / 撞墙" value="−1" /><Metric label="进入终点 G" value="+10" /></div><T>深色砖块写着“墙”，不能进入；撞墙后仍在原格。普通移动或撞墙得 −1，到达 G 得 +10。为了便于手算，本章取 γ=1。</T><Controls><Button onClick={() => { setPhase(0); setPlaying(true); }}>重播动画</Button><Button onClick={() => { setPlaying(false); setPhase(Math.min(5, phase + 1)); }} disabled={phase === 5}>下一幕</Button><Button onClick={() => setPlaying(!playing)} disabled={phase === 5}>{playing ? '暂停' : '继续'}</Button></Controls></div></div></Page>; }

export function PlayMazePage() { return <Page scene title="小狐狸怎样走，才能拿到最高分？" subtitle="先亲手探索这座迷宫，再试着找到一条得分更高的路线。"><MazeGame /></Page>; }

export function ObjectivePage() { const [route, setRoute] = useState<'direct' | 'bump'>('direct'); const direct = reference.filter((_, index) => index !== 1); const steps = route === 'direct' ? 6 : 7; return <Page title="训练策略到底想得到什么？" subtitle="每一步通常付出 −1，抵达 G 得 +10；更少的步数带来更高的总回报。" takeaway="目标是提高按当前策略反复采样时的平均回报，而不是只记住某一条路线。"><div className="pg-re-scene"><MazeBoard steps={route === 'direct' ? direct : reference} visible={steps} position={GOAL} wallFlash={route === 'bump'} /><div className="pg-re-stack"><Tag>从游戏目标到训练目标</Tag><H>让多次尝试的平均成绩更高</H><Controls><Button active={route === 'direct'} onClick={() => setRoute('direct')}>六步直达</Button><Button active={route === 'bump'} onClick={() => setRoute('bump')}>七步且撞墙</Button></Controls><T>{route === 'direct' ? '直达路线：右 → 右 → 上 → 上 → 上 → 右。' : '从 A 向上撞墙后仍在 A，再向右离开；因此多付出一步。'}</T><div className="pg-re-pair"><Metric label="本次步数" value={`${steps} 步`} /><Metric label="本次总回报" value={route === 'direct' ? '+5' : '+4'} /></div><F latex="J(\theta)=\mathbb{E}_{\tau\sim\pi_\theta}[G_0]" /><T>θ 是策略网络的参数；τ 是按该策略走出的一整局；G₀ 是这一局的总回报；期望表示要看许多可能的经历。</T></div></div></Page>; }

export function StateNetworkPage() { const [cell, setCell] = useState(START); const index = cell === START ? 12 : 13; return <Page title="迷宫状态怎样交给神经网络？" subtitle="先用一个最小的深度学习模型：16 个格子对应 16 维 one-hot 输入，线性层输出四个偏好分数。" takeaway="迷宫只是输入；参数是网络权重。用 one-hot 线性层时，每个状态对应一列可学习参数。"><div className="pg-re-scene"><MazeBoard position={cell} /><div className="pg-re-stack"><Controls><Button active={cell === START} onClick={() => setCell(START)}>输入状态 S</Button><Button active={cell === A} onClick={() => setCell(A)}>输入状态 A</Button></Controls><div className="pg-re-network"><div><H>状态</H><T>第 {index + 1} 位为 1</T><T small tone="muted">其余 15 位为 0</T></div><div className="pg-re-network-connector"><H>→</H></div><div><H>线性层</H><T>W · one-hot(s)</T><T small tone="muted">W 有 4 × 16 个权重</T></div><div className="pg-re-network-connector"><H>→</H></div><div><H>4 个 logit</H><T>上 / 下 / 左 / 右</T></div></div><F latex="z(s)=W\,\mathrm{onehot}(s),\qquad \pi_\theta(a\mid s)=\mathrm{softmax}(z(s))_a"/><T>它与普通分类网络一样有输入、可训练权重和 softmax；不同的是，训练信号来自与环境交互后的回报。</T></div></div></Page>; }

export function SamplingPage() { const [u, setU] = useState(.84); const cumulative = initialA.reduce<number[]>((all, value) => [...all, (all.at(-1) ?? 0) + value], []); const selected = DIRECTIONS[cumulative.findIndex(end => u < end)] ?? 'R'; return <Page title="网络输出概率，动作从概率中采样" subtitle="A 格当前输出：上 10%、下 10%、左 10%、右 70%。移动随机数，看这次会采到哪个方向。" takeaway="概率输出是模型的预测；真正执行的动作是一次随机采样结果。"><div className="pg-re-scene"><MazeBoard position={A} /><div className="pg-re-stack"><Probabilities picked={selected} /><Meter /><RangeControl label="采样用随机数 u" min={0} max={.99} step={.01} digits={2} value={u} onChange={event => setU(Number(event.target.value))} /><Metric label="这次采到的动作" value={`${ARROW[selected]} 向${DIR_LABEL[selected]}`} active /><T>把区间 [0,1) 按四个概率依次分开；随机数落在哪一段，就执行相应动作。概率 70% 也不保证单次一定向右。</T></div></div></Page>; }

export function EpisodePage() { const [visible, setVisible] = useState(0); const current = visible ? reference[visible - 1] : null; return <Page title="先采样一整局：只有经历，还没有更新" subtitle="为了让每个数字都能复核，使用固定随机数重放一条可能由当前策略采出的轨迹。" takeaway="每一步存状态、采到的动作及概率、环境奖励；REINFORCE 到终点以后才计算回报和更新。"><div className="pg-re-scene"><div className="pg-re-stack"><MazeBoard steps={reference} visible={visible} position={current?.next ?? START} wallFlash={current?.wall} /><Timeline visible={visible} selected={visible - 1} /></div><div className="pg-re-stack"><Tag>采样 {visible} / 7 步</Tag><H>{current ? current.wall ? '向上撞墙：仍在 A' : current.terminal ? '到达 G：本局结束' : `执行 ${ARROW[current.action]}，进入下一格` : '从 S 开始，策略逐步决定动作'}</H>{current ? <><Metric label="这一步的采样随机数 / 动作概率" value={`${draws[visible - 1].toFixed(2)} / ${percent(current.probability)}`} /><div className="pg-re-pair"><Metric label="这一步的奖励" value={current.reward > 0 ? '+10' : '−1'} /><Metric label="累计奖励" value={format(reference.slice(0, visible).reduce((sum, step) => sum + step.reward, 0))} /></div></> : <T>点“采样下一步”，依次看策略输出、随机数落点、环境反馈。</T>}<Controls><Button variant="primary" onClick={() => setVisible(Math.min(7, visible + 1))} disabled={visible === 7}>采样下一步</Button><Button onClick={() => setVisible(0)}>重新采样这组随机数</Button></Controls><T small tone="muted">固定随机数只是为了课堂复现；动作仍严格按照对应状态的概率区间选取。</T></div></div></Page>; }

export function ReturnPage() { const [index, setIndex] = useState(6), [show, setShow] = useState(false); const step = reference[index]; return <Page title="终点到了，倒着计算每一步的回报" subtitle="γ=1；从某一步开始，把那一步及后续所有奖励相加。先选一步，再揭示答案。" takeaway="即时奖励 rₜ 与后续回报 Gₜ 是不同的量。撞墙当下 r₁=−1，但这条成功轨迹的 G₁=5。"><div className="pg-re-scene"><div className="pg-re-stack"><MazeBoard steps={reference} visible={7} position={GOAL} focus={index} /><Timeline visible={7} selected={index} onSelect={next => { setIndex(next); setShow(false); }} /></div><div className="pg-re-stack"><Tag>现在回看第 {index + 1} 步</Tag><F latex="G_t=r_t+\gamma G_{t+1},\quad \gamma=1" /><T>本步动作 {ARROW[step.action]}；即时奖励 {step.reward > 0 ? '+10' : '−1'}。从这里到终点一共还有 {7 - index} 笔奖励。</T><Button variant="primary" onClick={() => setShow(true)}>揭示这一步的回报</Button>{show && <Metric label={`第 ${index + 1} 步的后续回报`} value={`G${index} = ${format(rewards[index])}`} active />}<T small tone="muted">角色仍在终点；橙色框表示正在回看历史中的哪一步，并非倒着走迷宫。</T></div></div></Page>; }

const formulaTerms = [
  { label: 'θ', title: '要训练的参数', detail: '这里是策略网络 W 的权重。改变 θ，会改变各状态输出的四个动作概率。' },
  { label: 'α', title: '学习率', detail: '控制一次更新迈多大步。太大容易震荡；太小则改变缓慢。' },
  { label: 'Gₜ', title: '这一步的学习信号', detail: '沿本次轨迹，从第 t 步一直到终点的实际回报；必须先完成这一局才能知道。' },
  { label: 'log π', title: '所选动作的对数概率', detail: 'sₜ 是第 t 步所在格子，aₜ 是当时采到的动作。πθ(aₜ|sₜ) 是策略给这个动作的概率；对数概率的梯度指出怎样改变网络参数。' },
  { label: 'Σ', title: '把所有步骤合起来', detail: 'T 是本局总步数；从 t=0 到 T−1，把每步对共享网络参数的贡献相加，再做一次更新。' },
];
export function FormulaPage() { const [term, setTerm] = useState(0); return <Page title="REINFORCE 的更新式，每一部分从哪里来？" subtitle="无需推导定理，先把公式读成一条可执行的流程。点击符号，看它指向哪份数据。" takeaway="采样提供 s、a、r；倒算得到 G；策略网络提供 log 概率及其梯度；学习率控制更新幅度。"><div className="pg-re-scene pg-re-formula"><div className="pg-re-stack"><div className="pg-re-panel is-blue"><F latex="\Delta\theta=\alpha\sum_{t=0}^{T-1}G_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)" /></div><div className="pg-re-chips"><T small>读法：旧参数</T><T small>＋ 学习率 × 全局轨迹贡献</T></div><MazeBoard steps={reference} visible={7} position={GOAL} /></div><div className="pg-re-stack"><Controls>{formulaTerms.map((item, i) => <Button key={item.label} active={term === i} onClick={() => setTerm(i)}>{item.label}</Button>)}</Controls><div className="pg-re-panel is-warm"><Tag>公式中的 {formulaTerms[term].label}</Tag><H>{formulaTerms[term].title}</H><T>{formulaTerms[term].detail}</T></div><T>更新目标是提高预期回报。这里的“＋”表示沿梯度上升；深度学习框架通常用梯度下降，所以代码里会把损失写成负号。</T></div></div></Page>; }

export function ScorePage() { const [chosen, setChosen] = useState<Direction>('U'); const index = DIRECTIONS.indexOf(chosen); const score = initialA.map((prob, i) => (i === index ? 1 : 0) - prob); return <Page title="一笔动作怎样影响四个输出？" subtitle="在 A 格，softmax 的四个概率绑在一起；改变所选动作时，其余三个方向也会联动。" takeaway="∇logπ 负责指出参数方向，Gₜ 决定这一笔经历给该方向多大权重。"><div className="pg-re-scene"><MazeBoard position={A} /><div className="pg-re-stack"><Controls>{DIRECTIONS.map(direction => <Button key={direction} active={chosen === direction} onClick={() => setChosen(direction)}>{ARROW[direction]} {DIR_LABEL[direction]}</Button>)}</Controls><Probabilities picked={chosen} /><F latex="\nabla_{z_i}\log\pi(a\mid A)=\mathbf{1}[i=a]-\pi(i\mid A)" /><div className="pg-re-compare">{DIRECTIONS.map((direction, i) => <div key={direction} className={chosen === direction ? 'is-picked' : ''}><T small>{DIR_LABEL[direction]}</T><H>{score[i].toFixed(2)}</H></div>)}</div><T>指示项 1[i=a] 在方向 i 等于本次动作时为 1，否则为 0。选中{DIR_LABEL[chosen]}时，它的分数梯度为 {score[index].toFixed(2)}；其他方向为各自概率的负数。四项加起来为 0。</T></div></div></Page>; }

export function UpdateCasePage() { const [mode, setMode] = useState<'wall' | 'exit' | 'all'>('wall'); const old = initialA; const singleLogits = (step: number) => { const actionIndex = DIRECTIONS.indexOf(reference[step].action); return policy[A].map((value, i) => value + .05 * rewards[step] * ((i === actionIndex ? 1 : 0) - old[i])); }; const afterZ = mode === 'wall' ? singleLogits(1) : mode === 'exit' ? singleLogits(2) : updatedA.after[A]; const after = probabilities(afterZ); return <Page title="实际更新 A 格：参数和概率都变了多少？" subtitle="A 被访问两次：先向上撞墙，再向右离开。两次使用同一列网络权重。" takeaway="真正的一局更新要合并两次访问。正的单步回报不表示撞墙是好动作；单局梯度可能有噪声。"><div className="pg-re-scene"><div className="pg-re-stack"><MazeBoard steps={reference} visible={7} position={GOAL} focus={mode === 'exit' ? 2 : 1} /><Timeline visible={7} selected={mode === 'exit' ? 2 : 1} showReturns /></div><div className="pg-re-stack"><Controls><Button active={mode === 'wall'} onClick={() => setMode('wall')}>① 撞墙贡献</Button><Button active={mode === 'exit'} onClick={() => setMode('exit')}>② 向右贡献</Button><Button active={mode === 'all'} onClick={() => setMode('all')}>③ 合并更新</Button></Controls><F latex={mode === 'all' ? '\\Delta z_A=0.05[5\\nabla\\log\\pi(\\uparrow\\mid A)+6\\nabla\\log\\pi(\\rightarrow\\mid A)]' : mode === 'wall' ? '\\Delta z_A=0.05\\times5\\times\\nabla\\log\\pi(\\uparrow\\mid A)' : '\\Delta z_A=0.05\\times6\\times\\nabla\\log\\pi(\\rightarrow\\mid A)'} /><ParameterChange after={afterZ} /><div className="pg-re-pair"><Metric label={mode === 'all' ? '向上概率：更新前 → 合并后' : '向上概率：更新前 → 单独作用后'} value={`${percent(old[0])} → ${percent(after[0])}`} active /><Metric label={mode === 'all' ? '向右概率：更新前 → 合并后' : '向右概率：更新前 → 单独作用后'} value={`${percent(old[3])} → ${percent(after[3])}`} /></div>{mode === 'all' && <T>合并后的向上概率约 12.7%，竟然上升了。原因是这条成功轨迹中混入一次撞墙；一次样本不足以代表长期优劣。</T>}<T small tone="muted">前两项是各自单独作用于旧参数的假设结果；第三项才是本局实际合并后的更新。</T></div></div></Page>; }

const codeExplanations = [
  '每局开始时，建立奖励表和所选动作 log 概率表。', '把格子位置变成 16 维输入。', '前向传播：网络输出四个动作概率。', '用四个概率定义一个可采样的动作分布。', '采一个动作，同时保存这个动作的 log 概率，供终局后计算损失。', '与环境交互，保存即时奖励；重复前面几行，直到终点。', '终点之后，从后往前得到每一步的 Gₜ。', '把每步的 −Gₜ logπ 加起来，形成可交给框架的损失。', '先清除上次留下的梯度。', '反向传播并更新网络权重；再次前向传播时，输出概率就会变化。',
];
export function DeepLearningPage() { const [active, setActive] = useState(0); return <Page title="这与深度学习训练代码如何接起来？" subtitle="迷宫策略是一个四分类网络；特别之处在于训练信号来自采样经历与回报。" takeaway="前向传播得到概率，采样与环境产生回报，负的加权 log 概率组成损失，反向传播更新权重。"><div className="pg-re-scene is-wide"><Code active={active} /><div className="pg-re-stack"><Tag>PyTorch 风格伪代码 · 第 {active + 1} 行</Tag><H>{codeExplanations[active]}</H><Controls><Button onClick={() => setActive(Math.max(0, active - 1))} disabled={active === 0}>上一行</Button><Button variant="primary" onClick={() => setActive(Math.min(codeExplanations.length - 1, active + 1))} disabled={active === codeExplanations.length - 1}>下一行</Button></Controls><div className="pg-re-highlight"><T>在这里 one-hot + 线性层与每个格子单独存四个 logit 等价；改用隐藏层时，参数还会在不同状态间共享。</T></div></div></div></Page>; }

export function FullLoopPage() { const [visible, setVisible] = useState(0), [stage, setStage] = useState<'collect' | 'return' | 'update'>('collect'); const activeStep = Math.max(0, visible - 1); const current = reference[activeStep]; const displayAfter = stage === 'update'; const next = () => { if (stage === 'collect') { if (visible < 7) setVisible(visible + 1); else setStage('return'); } else if (stage === 'return') setStage('update'); }; const reset = () => { setVisible(0); setStage('collect'); }; return <Page title="完整实验：亲手采样，再更新网络" subtitle="按一次“下一步”，只发生一件事：采样一个动作、倒算回报，或更新参数。" takeaway="这页把 REINFORCE 变成一个完整循环；更新后再用新参数前向传播，A 格动作概率确实发生变化。"><div className="pg-re-scene"><div className="pg-re-stack"><MazeBoard steps={reference} visible={visible} position={visible ? reference[visible - 1].next : START} focus={stage === 'return' ? 1 : -1} wallFlash={stage === 'collect' && visible === 2} /><Timeline visible={visible} selected={stage === 'collect' ? visible - 1 : 1} showReturns={stage !== 'collect'} /></div><div className="pg-re-stack"><Tag>{stage === 'collect' ? `第 1 阶段 · 采样 ${visible}/7` : stage === 'return' ? '第 2 阶段 · 计算回报' : '第 3 阶段 · 更新网络'}</Tag><H>{stage === 'collect' ? visible ? `第 ${visible} 步：${ARROW[current.action]}，奖励 ${format(current.reward)}` : '在 S 等待策略选择动作' : stage === 'return' ? '已到 G：倒算得 G₁=5、G₂=6' : '一次优化器更新已经完成'}</H><div className="pg-re-progress"><span style={{ width: `${(stage === 'collect' ? visible : stage === 'return' ? 8 : 9) / 9 * 100}%` }} /></div>{stage === 'update' && <ParameterChange after={updatedA.after[A]} />}<div className="pg-re-pair"><Metric label="A 格向上概率" value={displayAfter ? `${percent(initialA[0])} → ${percent(updatedA.newProbs[0])}` : percent(initialA[0])} active={displayAfter} /><Metric label="A 格向右概率" value={displayAfter ? `${percent(initialA[3])} → ${percent(updatedA.newProbs[3])}` : percent(initialA[3])} /></div>{stage === 'collect' && visible > 0 && <T>随机数 {draws[visible - 1].toFixed(2)} 落入 {DIR_LABEL[current.action]}的概率区间；这一动作当时概率为 {percent(current.probability)}。</T>}{stage === 'return' && <T>从终点往前加奖励：撞墙那步 G₁=5；紧接着从 A 向右那步 G₂=6。</T>}{stage === 'update' && <T>两次访问 A 的梯度先合并，再改同一列权重。新输出来自更新后的网络前向传播。</T>}<Controls><Button variant="primary" onClick={next} disabled={stage === 'update'}>{stage === 'collect' && visible < 7 ? '采样下一步' : stage === 'collect' ? '倒算回报' : '更新参数并查看输出'}</Button><Button onClick={reset}>从头再来</Button></Controls></div></div></Page>; }

export function TrainingPage() { const [run, setRun] = useState<TrainState>(() => newTrain(123)); const recent = run.returns.slice(-25), min = Math.min(0, ...recent), max = Math.max(10, ...recent), span = max - min || 1; return <Page title="一局不够：让策略反复采样与更新" subtitle="这里每局都按照当时的概率采样，走完以后运行真实的 REINFORCE 更新。" takeaway="回报会因采样上下波动；判断训练效果，应看多局的趋势和概率变化，而非某一次路径。"><div className="pg-re-scene"><MazeBoard steps={run.last} visible={run.last.length} position={run.last.at(-1)?.next ?? START} /><div className="pg-re-stack"><Tag>真实训练 · 不是预设轨迹</Tag><div className="pg-re-pair"><Metric label="已训练局数" value={`${run.episodes}`} /><Metric label="上一局回报" value={run.returns.length ? format(run.returns.at(-1)!) : '—'} /></div><div className="pg-re-panel"><T small tone="muted">最近 {recent.length} 局的实际回报</T><div className="pg-re-training-chart" role="img" aria-label="最近若干局回报柱状图">{recent.map((value, i) => <span key={i} title={`回报 ${value}`} style={{ height: `${Math.max(8, (value - min) / span * 100)}%` }} />)}</div></div><Probabilities probs={probabilities(run.policy[A])} precise /><Controls><Button onClick={() => { setRun(previous => train(previous, 1)); }}>训练 1 局</Button><Button variant="primary" onClick={() => { setRun(previous => train(previous, 10)); }}>训练 10 局</Button><Button onClick={() => setRun(newTrain(123))}>重置</Button></Controls><T small tone="muted">上一局可能绕路或撞墙；训练演示人为设置 30 步超时，超时也结束该局。曲线显示实际奖励总和；新局使用更新后的策略。</T></div></div></Page>; }

const questions = [
  { question: '网络在 A 输出“向右 70%”，下一次一定向右吗？', options: ['一定', '不一定'], answer: 1, why: '概率描述多次采样的分布，单次可能落在其他方向。' },
  { question: '撞墙当下奖励 −1，这条轨迹从撞墙开始的 G₁ 是多少？', options: ['−1', '+5', '+10'], answer: 1, why: 'G₁ 把撞墙之后直到终点的奖励全部相加，等于 +5。' },
  { question: 'REINFORCE 什么时候改网络参数？', options: ['每走一步立刻改', '整局采样并算完回报后'], answer: 1, why: '它需要终局后的实际后续回报作为每一步的权重。' },
  { question: 'A 在同一局被访问两次，更新 A 的参数时怎么办？', options: ['只看撞墙', '只看离开', '合并两次贡献'], answer: 2, why: '两次访问共享同一列参数，两笔梯度相加。' },
];
export function WrapPage() { const [index, setIndex] = useState(0), [choice, setChoice] = useState<number | null>(null), [reveal, setReveal] = useState(false); const item = questions[index]; return <Page title="把整条学习链说清楚" subtitle="从同一座迷宫出发，检查你能否解释采样、回报和参数更新。" takeaway="下一章才会讨论如何降低 REINFORCE 的波动；这章先把最基本的策略梯度流程走通。"><div className="pg-re-scene"><div className="pg-re-stack"><MazeBoard steps={reference} visible={7} position={GOAL} /><div className="pg-re-arrowline"><div><T>网络输出概率</T></div><div><T>按概率走迷宫</T></div><div><T>回报驱动更新</T></div></div></div><div className="pg-re-stack"><Tag>理解检查 {index + 1} / {questions.length}</Tag><H>{item.question}</H><Controls>{item.options.map((option, i) => <Button key={option} active={choice === i} onClick={() => { setChoice(i); setReveal(false); }}>{option}</Button>)}</Controls><Controls><Button variant="primary" disabled={choice === null} onClick={() => setReveal(true)}>检查</Button><Button onClick={() => { setIndex((index + 1) % questions.length); setChoice(null); setReveal(false); }}>下一题</Button></Controls>{reveal && <div className="pg-re-highlight"><T tone={choice === item.answer ? 'success' : 'danger'}>{choice === item.answer ? '回答正确。' : '再想一步。'}</T><T>{item.why}</T></div>}<div className="pg-re-ref"><T small tone="muted">阅读来源：《动手学强化学习》第 9 章策略梯度；《动手学深度学习》的 softmax 与反向传播；OpenAI Spinning Up 的 reward-to-go。迷宫与数值为本课教学设计。</T></div></div></div></Page>; }
