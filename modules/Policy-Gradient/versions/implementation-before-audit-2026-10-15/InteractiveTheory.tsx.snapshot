import { useState } from 'react';
import { Button, RangeControl } from '../../shared/react';
import { Page, T, H, F, Controls } from '../components/LessonVisuals';
import { MazeBoard, ARROW } from '../components/ReinforceMaze';
import { START, GOAL, DIRECTIONS, DIR_LABEL, returns, transition, type Step } from '../mazeModel';
import { DEMO, DEMO_PATH, forward, updateNetwork, episode, RATE } from '../neuralPolicy';
import './interactiveTheory.css';
const sigmoid=(x:number)=>1/(1+Math.exp(-x));
const toy=(x:number)=>3+2*sigmoid(x);
const toyGradient=(x:number)=>2*sigmoid(x)*(1-sigmoid(x));
let detourCell=START;
const detourPath:Step[]=[3,3,3,2,0,0,0,3].map(a=>{const state=detourCell,result=transition(state,DIRECTIONS[a]);detourCell=result.next;return{state,action:DIRECTIONS[a],probability:forward(DEMO,state).p[a],...result};});
function Maze({steps=DEMO_PATH,focus=-1,visible=steps.length}:{steps?:Step[];focus?:number;visible?:number}){return <div className="pg-tr-board pg-it-board"><MazeBoard position={visible?steps[Math.min(visible,steps.length)-1].next:START} steps={steps} visible={visible} focus={focus} fox showPath/></div>}
export function GradientAscentLesson(){const[x,setX]=useState(0),[rate,setRate]=useState(1),[direction,setDirection]=useState(0);const g=toyGradient(x),next=x+direction*rate*g;const curve=Array.from({length:101},(_,i)=>{const w=-4+i*.08;return `${i?'L':'M'}${50+(w+4)/8*660},${260-(toy(w)-3)/2*210}`;}).join(' ');const cx=(v:number)=>50+(v+4)/8*660,cy=(v:number)=>260-(toy(v)-3)/2*210;return <Page title="目标更高，权重该往哪里改？" subtitle="试着加上一小步梯度，看期望得分怎样变。" takeaway="梯度给方向，α 给步长；实际模型用采样经历估计这个方向。"><div className="pg-it-ascent"><div className="pg-it-curve"><svg viewBox="0 0 760 300" role="img" aria-label={`示意权重 ${x.toFixed(2)}，期望得分 ${toy(x).toFixed(3)}；更新后 ${toy(next).toFixed(3)}`}><path d="M50 28V260H730" stroke="#becdd8" fill="none"/><path d={curve} stroke="#315b7b" strokeWidth="4" fill="none"/><circle cx={cx(x)} cy={cy(x)} r="8" fill="#e49c44"/>{direction!==0&&<><path d={`M${cx(x)} ${cy(x)}L${cx(next)} ${cy(next)}`} stroke={direction>0?'#548477':'#b26b56'} strokeWidth="4"/><circle cx={cx(next)} cy={cy(next)} r="8" fill={direction>0?'#548477':'#b26b56'}/></>}</svg><div className="pg-it-axis"><T small>纵轴：期望得分 J</T><T small>横轴：示意权重 θ</T></div><RangeControl label={`当前权重 θ：${x.toFixed(1)}`} min={-3} max={3} step={.1} value={x} onChange={e=>{setX(Number(e.target.value));setDirection(0);}}/><T small tone="muted">两路线 softmax 示意：分数 [θ, 0] → 短路线 {(sigmoid(x)*100).toFixed(1)}%，绕路 {((1-sigmoid(x))*100).toFixed(1)}%。</T></div><div className="pg-it-stack"><H>加号，把权重推向更高的得分</H><F latex={String.raw`\theta_{\mathrm{new}}=\theta+\alpha\nabla_\theta J`}/><div className="pg-it-facts"><div><T small>当前梯度 ∇θJ</T><H>{g.toFixed(3)}</H></div><div><T small>更新后的权重</T><H>{next.toFixed(3)}</H></div></div><RangeControl label={`学习率 α：${rate.toFixed(1)}`} min={0} max={2} step={.1} value={rate} onChange={e=>setRate(Number(e.target.value))}/><Controls><Button variant="primary" active={direction===1} onClick={()=>setDirection(1)}>加梯度，试一次</Button><Button active={direction===-1} onClick={()=>setDirection(-1)}>反方向对照</Button></Controls><div className="pg-it-result" aria-live="polite"><T small>期望得分</T><H>{toy(x).toFixed(3)} → {toy(next).toFixed(3)}</H><T small>{direction===0?'橙点：更新前。点击按钮比较。':rate===0?'步长为 0，权重和得分都不变。':direction>0?'绿点：加梯度，期望得分提高。':'红点：反方向移动，期望得分降低。'}</T></div></div></div></Page>}
export function ObjectiveGradientDerivationLesson(){const[pick,setPick]=useState(0);const p=[.6,.4],r=[5,3],logGradient=[.4,-.6],contribution=p.map((v,i)=>v*r[i]*logGradient[i]);return <Page title="先看整局：怎样从得分找到梯度？" subtitle="点击一条路线，看“概率 × 得分 × 调整方向”怎样组成梯度。" takeaway="两路线示意中：1.20 − 0.72 = 0.48。完整迷宫要对所有轨迹求和，再用采样近似。"><div className="pg-it-derive"><div className="pg-it-route-picks">{[0,1].map(i=><div className={pick===i?'is-selected':''} key={i}><H>{i===0?'短路线 · 5 分':'绕路线 · 3 分'}</H><Maze steps={i?detourPath:DEMO_PATH}/><Button active={pick===i} onClick={()=>setPick(i)}>检查{i===0?'短路线':'绕路线'}</Button></div>)}</div><div className="pg-it-stack"><T small>τ：轨迹；Pπθ(τ)：出现概率；R(τ)：得分</T><div className="pg-it-facts three"><div><T small>概率 P</T><H>{p[pick]}</H></div><div><T small>得分 R</T><H>{r[pick]}</H></div><div><T small>log 概率梯度</T><H>{logGradient[pick]}</H></div></div><F latex={String.raw`${p[pick]}\times${r[pick]}\times(${logGradient[pick]})=${contribution[pick].toFixed(2)}`}/><T small>{pick===0?'两路线 softmax 的反向传播：1 − 0.6 = 0.4。':'两路线 softmax 的反向传播：−0.6。'}</T><div className="pg-it-identity"><T small>链式法则 · log 为自然对数</T><F latex={String.raw`\nabla_\theta P=P\nabla_\theta\log P`}/></div></div><div className="pg-it-wide-rule"><F latex={String.raw`\nabla_\theta J=\sum_\tau P_{\pi_\theta}(\tau)R(\tau)\nabla_\theta\log P_{\pi_\theta}(\tau)`}/><T small>Σ：合并所有轨迹。这就是按策略取期望 E；得分不对 θ 求导。</T></div></div></Page>}
export function TrajectoryGradientDerivationLesson(){const[t,setT]=useState(1);const gains=returns(DEMO_PATH),step=DEMO_PATH[t];return <Page title="再看每步：概率和回报怎样拆开？" subtitle="点击一步：淡色是过去，蓝色是这一步之后的奖励。t 从 0 计。" takeaway="过去奖励的梯度项期望为 0，所以用后续回报 Gₜ 加权；各步贡献相加，再取期望。"><div className="pg-it-step-derive"><div className="pg-it-step-scene"><div className="pg-it-stack"><Maze focus={t}/><T small>回看第 {t+1} 步 · 向{DIR_LABEL[step.action]}</T><T small>当时所选动作概率：{(step.probability*100).toFixed(1)}%</T></div><div className="pg-it-stack"><H>一条轨迹，由每步动作组成</H><div className="pg-it-rewards">{DEMO_PATH.map((s,i)=><Button key={i} active={t===i} className={i<t?'is-past':'is-future'} onClick={()=>setT(i)}><T small>{i+1} {ARROW[s.action]}</T><H>{s.reward}</H></Button>)}</div><F latex={String.raw`G_{${t}}=${DEMO_PATH.slice(t).map((s,i)=>s.reward===10?(i?'+10':'10'):'-1').join('')}=${gains[t]}`}/><T small>Gₜ：本步起的奖励之和。</T><div className="pg-it-identity"><T small>轨迹概率连乘；log 把连乘变求和</T><F latex={String.raw`\log P_{\pi_\theta}(\tau)=\sum_t\log\pi_\theta(a_t\mid s_t)`}/></div></div></div><div className="pg-it-wide-rule"><F latex={String.raw`\nabla_\theta J=\mathbb E_{\tau\sim P_{\pi_\theta}}\left[\sum_tG_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)\right]`}/><T small>∇θlogπθ(aₜ|sₜ)：提高所选动作概率的权重方向；Gₜ：加权信号。</T></div></div></Page>}
export function ReinforceIntroLesson(){const[phase,setPhase]=useState(0),[network,setNetwork]=useState(DEMO),[path,setPath]=useState(DEMO_PATH),[seed,setSeed]=useState(223),[round,setRound]=useState(1);const gains=returns(path),update=updateNetwork(network,path),state=START+1,action=3,before=forward(network,state).p[action],after=forward(update.after,state).p[action];const next=()=>{if(phase<3){setPhase(phase+1);return;}const[nextPath,nextSeed]=episode(update.after,seed);setNetwork(update.after);setPath(nextPath);setSeed(nextSeed);setRound(round+1);setPhase(1);};return <Page title="REINFORCE：把一局经历变成一次更新" subtitle="亲手推进一轮：采样 → 算回报 → 更新 → 用新策略再采样。" takeaway="采样期间权重固定，终局后更新一次。蒙特卡洛：用实际经历估计期望。"><div className="pg-it-loop"><div className="pg-it-loop-scene"><div className="pg-it-stack"><Maze steps={path} visible={phase?path.length:0} focus={phase===3?path.findIndex(s=>s.state===state):-1}/><T small>第 {round} 局 · {round===1?'固定教学抽数':'当前策略随机采样'}</T><T small>{phase?`${path.length} 步 · 得分 ${gains[0]}`:'尚未采样'}</T></div><div className="pg-it-stack"><div className="pg-it-loop-artifacts">{[['① 采样一局',phase>=1?`${path.length} 条经验`:'等待采样'],['② 计算回报',phase>=2?`G₀ = ${gains[0]}`:'等待计算'],['③ 更新权重',phase>=3?'新策略已算出':'等待更新']].map((v,i)=><div className={phase===i+1?'is-current':''} key={v[0]}><T small>{v[0]}</T><H>{v[1]}</H></div>)}</div><div className="pg-it-result"><T small>第 4 行第 2 列·向右概率</T><H>{(before*100).toFixed(4)}% → {((phase===3?after:before)*100).toFixed(4)}%</H><T small>{phase===3?`变化 ${((after-before)*100).toFixed(4)} 个百分点；由新权重重算。`:'更新前，输出概率保持不变。'}</T></div><Controls><Button variant="primary" onClick={next}>{['采样一局','计算回报','更新网络','用新策略再采样'][phase]}</Button><Button onClick={()=>{setNetwork(DEMO);setPath(DEMO_PATH);setSeed(223);setRound(1);setPhase(0);}}>重置</Button></Controls></div></div><div className="pg-it-wide-rule"><F latex={String.raw`\theta_{\mathrm{new}}=\theta+\alpha\widehat g`}/><T small>α = {RATE}；ĝ：这一局各步贡献的和。下一页拆解“采样”每一步。</T></div></div></Page>}
