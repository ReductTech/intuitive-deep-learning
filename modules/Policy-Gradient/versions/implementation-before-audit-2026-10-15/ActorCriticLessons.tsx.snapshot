import { useState } from 'react';
import { Button, RangeControl } from '../../shared/react';
import { Page, T, H, F, Controls } from '../components/LessonVisuals';
import { MazeBoard, ARROW } from '../components/ReinforceMaze';
import { START, GOAL, DIRECTIONS, DIR_LABEL } from '../mazeModel';
import { forward, episode } from '../neuralPolicy';
import { newACRun, trainAC, qValues } from '../actorCritic';
import { TrainingCurve } from './TrainingLessons';
import './actorCritic.css';
const initial=newACRun();
// A real training snapshot; the successful path is not manually imposed.
const example=trainAC(initial,1000);
const name=(s:number)=>`第 ${Math.floor(s/4)+1} 行第 ${s%4+1} 列`;
function Board({cell=START,steps=[],focus=-1,onSelect}:{cell?:number;steps?:typeof example.last[number]['step'][];focus?:number;onSelect?:(s:number)=>void}){return <div className="pg-ac-board pg-tr-board"><MazeBoard position={cell} steps={steps} focus={focus} compactLabels fox showPath onSelect={onSelect}/></div>}
function ActionRows({cell,actor=initial.actor,critic=initial.critic}:{cell:number;actor?:typeof initial.actor;critic?:typeof initial.critic}){return <div className="pg-ac-action-rows"><div><T small>方向</T><T small>Actor · 概率</T><T small>Critic · 估计回报</T></div>{DIRECTIONS.map((d,i)=><div key={d}><T small>{ARROW[d]} {DIR_LABEL[d]}</T><T small>{(forward(actor,cell).p[i]*100).toFixed(1)}%</T><T small>{qValues(critic,cell)[i].toFixed(2)}</T></div>)}</div>}
export function ACProgress({active=-1}:{active?:number}){return <div className="pg-ac-flow" role="list" aria-label="Actor-Critic 每步训练流程">{['① 按策略选动作','② 执行，得奖励','③ 算学习目标','④ 更新 Critic','⑤ 更新 Actor'].map((v,i)=><div key={v} role="listitem" aria-current={active===i?'step':undefined} className={active===i?'is-current':''}><T small>{v}</T></div>)}</div>}
export function ActorCriticIntro(){const[cell,setCell]=useState(START);return <Page title="Actor-Critic：让另一个网络评价选择" subtitle="REINFORCE 要等终局。能否走一步，就用学到的回报估计来更新？" takeaway="本节是 Q 型 Actor-Critic：初始评分不准，靠真实奖励逐步校准，再帮助策略学习。"><div className="pg-ac-loop-wrap pg-ac-intro-flow"><ACProgress/><div className="pg-ac-intro"><div className="pg-ac-left"><Board cell={cell} onSelect={c=>c!==GOAL&&setCell(c)}/><T small>{name(cell)} · 点击格子查看两个网络输出</T><div className="pg-ac-signal"><T small>策略更新的评价信号</T><F latex={String.raw`G_t\quad\text{vs.}\quad q_w(s_t,a_t)`}/><T small>Gₜ：这局实际回报；q：从本步起、继续按当前策略走的平均回报估计。</T></div></div><div className="pg-ac-right"><div className="pg-ac-models"><div><H>Actor · 策略网络</H><F latex={String.raw`\pi_\theta(a\mid s)`}/><T small>位置 s → 四个概率 · 权重 θ</T></div><div><H>Critic · 价值网络</H><F latex={String.raw`q_w(s,a)`}/><T small>位置 s → 四个回报估计 · 权重 w</T></div></div><ActionRows cell={cell}/><T small tone="muted">Critic 也用 16→8→4 网络，但不做 softmax；评分可以为负。</T></div></div></div></Page>}
export function ActorCriticStep(){const[t,setT]=useState(0),[phase,setPhase]=useState(0);const u=example.last[t],a=DIRECTIONS.indexOf(u.step.action),before=forward(u.actorBefore,u.step.state).p[a],after=forward(u.actorAfter,u.step.state).p[a];const newQ=qValues(u.criticAfter,u.step.state)[a];return <Page title="走一步，怎样更新两个网络？" subtitle="按流程回放真实训练第 1000 局的一步；旧网络先给动作概率和评价。" takeaway="两次更新都使用本步旧网络算出的值；完成后，在新位置用新策略重新选动作。"><div className="pg-ac-step"><ACProgress active={phase}/><div className="pg-ac-step-body"><div className="pg-ac-left"><Board cell={phase===0?u.step.state:u.step.next} steps={example.last.slice(0,t+(phase>0?1:0)).map(v=>v.step)} focus={t}/><RangeControl label={`回看第 ${t+1} 步 · 向${DIR_LABEL[u.step.action]}`} min={1} max={example.last.length} step={1} value={t+1} onChange={e=>{setT(Number(e.target.value)-1);setPhase(0);}}/><T small>{name(u.step.state)} · 向{DIR_LABEL[u.step.action]}概率 {(before*100).toFixed(1)}%</T><T small>本步奖励：{phase>0?u.step.reward:'待执行'}</T><Controls><Button variant="primary" onClick={()=>{if(phase<4)setPhase(phase+1);else if(t<example.last.length-1){setT(t+1);setPhase(0);}}} disabled={phase===4&&t===example.last.length-1}>{['执行这个动作','计算学习目标','更新 Critic','更新 Actor',t===example.last.length-1?'本局完成':'用新策略走下一步'][phase]}</Button><Button onClick={()=>setPhase(0)}>重播这一步</Button></Controls><T small tone="muted">回放已记录的真实更新，不重复训练。</T></div><div className="pg-ac-right"><div className={`pg-ac-target ${phase===2?'is-current':''}`}><H>③ 目标：奖励 + 后续估计</H><F latex={String.raw`y=r_t+\gamma q_w(s_{t+1},\widetilde a)`}/>{phase>=2?<F latex={String.raw`y=${u.step.reward}+${u.nextQ.toFixed(3)}=${u.target.toFixed(3)}`}/>:<T small>执行后，用旧 Critic 的下一位置估计计算目标。</T>}<T small>{u.terminal?'ã：下一位置的预抽动作；本局结束，后续估计取 0。':`ã：下一位置按旧策略预抽的“${DIR_LABEL[DIRECTIONS[u.preview]]}”，不执行。`} γ = 1。</T></div><div className="pg-ac-updates"><div className={phase===3?'is-current':''}><H>④ Critic：校准估计</H><F latex={String.raw`L_C=\tfrac12(q-y)^2`}/><T small>q：本步旧估计；y：固定目标</T><T small>估计：{u.q.toFixed(3)} → {phase>=3?newQ.toFixed(3):'待更新'}</T><T small>对价值权重 w 反向传播、梯度下降。</T></div><div className={phase===4?'is-current':''}><H>⑤ Actor：改变策略</H><F latex={String.raw`\theta\leftarrow\theta+\alpha q\nabla_\theta\log\pi_\theta(a_t\mid s_t)`}/><T small>α：策略学习率；q 固定为旧评分 {u.q.toFixed(3)}</T><T small>概率：{(before*100).toFixed(2)}% → {phase>=4?`${(after*100).toFixed(2)}%`:'待更新'}</T><T small>策略梯度上升：加上回报加权的梯度。</T></div></div></div></div></div></Page>}
export function ActorCriticTraining(){const[run,setRun]=useState(newACRun),[busy,setBusy]=useState(false),[cell,setCell]=useState(START);const train=async(n:number)=>{setBusy(true);let next=run;for(let done=0;done<n;done+=50){next=trainAC(next,Math.min(50,n-done));setRun(next);await new Promise(resolve=>setTimeout(resolve,0));}setBusy(false);};const evaluation=run.episodes?episode(run.actor,run.seed,true)[0]:[];const evaluationScore=evaluation.reduce((sum,v)=>sum+v.reward,0);const recent=run.scores.slice(-100),mean=recent.length?recent.reduce((a,b)=>a+b,0)/recent.length:null;return <Page title="真实训练：走一步，就学一步" subtitle="从随机网络开始，按概率采样；每一步实际更新 Actor 和 Critic。" takeaway="训练按概率采样，测试选最大概率；看平均得分和实际路线判断是否学好。每局最多 30 步。"><div className="pg-ac-loop-wrap"><ACProgress/><div className="pg-ac-training"><div className="pg-ac-left"><Board cell={run.last.at(-1)?.step.next??START} steps={run.last.map(v=>v.step)} onSelect={c=>c!==GOAL&&setCell(c)}/><T small>{run.last.length?`最近一局 · ${run.last.length} 步 · ${run.scores.at(-1)} 分`:'两个网络随机初始化，尚未训练'}</T><T small tone="accent">最大概率测试：{run.episodes?`${evaluation.length} 步 · ${evaluationScore} 分`:'尚未训练'}</T><Controls><Button variant="primary" disabled={busy} onClick={()=>train(1)}>训练 1 局</Button><Button disabled={busy} onClick={()=>train(100)}>训练 100 局</Button><Button disabled={busy} onClick={()=>train(1000)}>{busy?'训练中…':'训练 1000 局'}</Button><Button disabled={busy} onClick={()=>{setRun(newACRun());setCell(START);}}>重置</Button></Controls></div><div className="pg-ac-right"><div className="pg-ac-metrics"><H>已训练 {run.episodes} 局</H><T small>近 {recent.length||100} 局均分：{mean===null?'—':mean.toFixed(2)}</T></div><TrainingCurve scores={run.scores}/><T small tone="accent">{name(cell)} · 点击迷宫查看</T><ActionRows cell={cell} actor={run.actor} critic={run.critic}/></div></div></div></Page>}
