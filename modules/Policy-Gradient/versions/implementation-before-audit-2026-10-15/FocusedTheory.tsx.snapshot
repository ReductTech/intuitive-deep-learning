import { useState } from 'react';
import { Button } from '../../shared/react';
import { Page, T, H, F } from '../components/LessonVisuals';
import { MazeBoard, ARROW } from '../components/ReinforceMaze';
import { START, GOAL, DIRECTIONS, transition, returns, DIR_LABEL, type Step } from '../mazeModel';
import { DEMO, DEMO_PATH, forward } from '../neuralPolicy';
import './focusedTheory.css';
const gains=returns(DEMO_PATH);
function Maze({focus=-1,steps=DEMO_PATH}:{focus?:number;steps?:Step[]}){return <div className="pg-ft-maze pg-tr-board"><MazeBoard position={GOAL} steps={steps} focus={focus} fox showPath/></div>}
export function GradientAscentLesson(){return <Page title="目标确定了，网络权重怎样改？" subtitle="上一页改变路线概率；真正训练时，我们调整的是网络权重。" takeaway="先明确更新规则；接下来寻找能从走迷宫的经历中算出的梯度。"><div className="pg-ft-page"><div className="pg-ft-chain"><div><H>改权重</H><F latex={String.raw`\theta`}/><T small>两层网络的连接权重</T></div><T tone="accent">→</T><div><H>改变选择</H><F latex={String.raw`\pi_\theta(a\mid s)`}/><T small>各个位置的动作概率</T></div><T tone="accent">→</T><div><H>改变平均得分</H><F latex={String.raw`J(\theta)`}/><T small>希望越来越高</T></div></div><div className="pg-ft-central"><H>沿着提高目标的方向，改一小步</H><F latex={String.raw`\theta_{\mathrm{new}}=\theta+\underbrace{\alpha}_{\text{步长}}\underbrace{\nabla_\theta J(\theta)}_{\text{调整方向}}`}/></div><div className="pg-ft-pair"><div><T tone="accent">梯度：各个权重该往哪边改</T><T small>∇θJ 对每个权重给出一个局部调整方向。</T></div><div><T tone="accent">学习率：沿这个方向走多远</T><T small>提高回报用加号；降低损失用减号。α 控制步长。</T></div></div></div></Page>}
const detour:Step[]=(()=>{let state=START;return [3,3,3,2,0,0,0,3].map(a=>{const result=transition(state,DIRECTIONS[a]);const step={state,action:DIRECTIONS[a],probability:forward(DEMO,state).p[a],...result};state=result.next;return step;});})();
export function ObjectiveGradientDerivationLesson(){const[pick,setPick]=useState(0);const selected=pick?detour:DEMO_PATH;return <Page title="得分固定，改变的是路线出现的概率" subtitle="切换路线：走法决定这局得分；策略权重决定它出现的概率。" takeaway="log 改写让梯度成为可采样的期望，也让下一页能把整局拆成每一步。"><div className="pg-ft-derive"><div className="pg-ft-scene"><div className="pg-ft-route-select"><Button active={pick===0} onClick={()=>setPick(0)}>6 步 · 5 分</Button><Button active={pick===1} onClick={()=>setPick(1)}>8 步 · 3 分</Button></div><Maze steps={selected}/><H>这条路线始终得 {returns(selected)[0]} 分</H><T small>τ：整局轨迹 · R(τ)：这局得分</T><T small>Pπθ(τ)：策略产生它的概率</T></div><div className="pg-ft-equations"><div><H>① 平均得分 = 概率加权得分</H><F latex={String.raw`J(\theta)=\sum_\tau P_{\pi_\theta}(\tau)R(\tau)`}/></div><div><H>② 求梯度，只对概率求导</H><F latex={String.raw`\nabla_\theta J=\sum_\tau R(\tau)\nabla_\theta P_{\pi_\theta}(\tau)`}/></div><div className="pg-ft-identity"><T small>链式法则：P 简写路线概率；log 是自然对数</T><F latex={String.raw`\nabla_\theta P=P\nabla_\theta\log P`}/></div></div><div className="pg-ft-result"><F latex={String.raw`\nabla_\theta J=\mathbb E_{\tau\sim P_{\pi_\theta}}[R(\tau)\nabla_\theta\log P_{\pi_\theta}(\tau)]`}/><T small>Σ：合并所有路线；E：按策略取期望。路线得分 × log 概率的梯度。</T></div></div></Page>}
export function TrajectoryGradientDerivationLesson(){const[t,setT]=useState(1);return <Page title="每一步，用它之后的回报来评价" subtitle="点选一步，查看它之后的奖励；下标 t 从 0 计，本章 γ = 1。" takeaway="Gₜ 给评价；∇θlogπ 给调整方向，由策略网络反向传播算出。"><div className="pg-ft-steps"><div className="pg-ft-step-body"><div className="pg-ft-scene"><Maze focus={t}/><T small>回看第 {t+1} 步 · 向{DIR_LABEL[DEMO_PATH[t].action]}</T><T small>当时所选动作概率：{(DEMO_PATH[t].probability*100).toFixed(1)}%</T></div><div className="pg-ft-step-content"><H>从选中的这步开始，奖励才计入 Gₜ</H><div className="pg-ft-timeline">{DEMO_PATH.map((s,i)=><Button key={i} active={i===t} className={i===t?'is-current':i<t?'is-past':'is-future'} onClick={()=>setT(i)}><T small>第 {i+1} 步</T><T>{ARROW[s.action]}</T><T small>{s.reward>0?'+10':'−1'}</T></Button>)}</div><F latex={String.raw`G_{${t}}=${DEMO_PATH.slice(t).map((s,i)=>s.reward===10?(i?'+10':'10'):'-1').join('')}=${gains[t]}`}/><div className="pg-ft-identity"><T small>每步概率连乘得到路线概率；log 把连乘变求和</T><F latex={String.raw`\log P_{\pi_\theta}(\tau)=\sum_t\log\pi_\theta(a_t\mid s_t)`}/></div></div></div><div className="pg-ft-result"><F latex={String.raw`\nabla_\theta J=\mathbb E\left[\sum_tG_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)\right]`}/><T small>动作不能改变过去；过去奖励项的期望贡献为 0，所以在期望中用 Gₜ 替换 R。</T></div></div></Page>}
export function ReinforceIntroLesson(){return <Page title="REINFORCE：走完一局，再更新一次" subtitle="上一页对所有经历取期望；REINFORCE 用采到的一局，估计这个梯度。" takeaway="蒙特卡洛：用实际经历估计期望。下一页开始完整走一遍这三个步骤。"><div className="pg-ft-page pg-ft-algorithm-page"><T tone="accent">先随机初始化权重 θ，然后重复：</T><div className="pg-ft-algorithm"><div><T small>① 固定权重，采样一局</T><Maze/><T small>位置、动作、奖励 → 一条轨迹 τ</T></div><div><T small>② 终局后，算各步回报</T><div className="pg-ft-returns">{gains.map((g,i)=><div key={i}><T small>第 {i+1} 步</T><H>{g}</H></div>)}</div><T small>同一局算出六个 Gₜ，分别评价六次选择</T></div><div><T small>③ 合并梯度，更新权重</T><div className="pg-ft-update-icon"><H>一局经历</H><T tone="accent">↓</T><H>一次网络更新</H></div><T small>各步贡献相加 → ĝ → 新权重 θnew</T></div></div><div className="pg-ft-result"><F latex={String.raw`\theta_{\mathrm{new}}=\theta+\alpha\underbrace{\sum_tG_t\nabla_\theta\log\pi_\theta(a_t\mid s_t)}_{\widehat g\;\text{：这一局的梯度估计}}`}/><T small>α：学习率。单局估计有波动；反复采样、更新，观察平均表现。</T></div></div></Page>}
