import { useState } from 'react';
import { Button, RangeControl } from '../../shared/react';
import { Page, T, H, F, Controls } from '../components/LessonVisuals';
import './gradientComparison.css';
const rate=.1;
function Curve({kind,x,next}:{kind:'loss'|'return';x:number;next:number|null}){const fn=(v:number)=>kind==='loss'?v*v:5-(v-1)*(v-1),cx=(v:number)=>24+(v+2)/5*352,cy=(v:number)=>kind==='loss'?104-v/9*92:104-(v+4)/9*92;const d=Array.from({length:81},(_,i)=>{const v=-2+i*5/80;return `${i?'L':'M'}${cx(v)},${cy(fn(v))}`}).join(' ');return <svg viewBox="0 0 400 124" role="img" aria-label={`${kind==='loss'?'损失':'回报'}曲线，橙点为当前权重${x}${next===null?'':`，蓝点为更新后${next}`}`}><path d="M24 8V104H384" fill="none" stroke="#c6d5e0"/><path d={d} fill="none" stroke="#7796aa" strokeWidth="2.5"/><circle cx={cx(x)} cy={cy(fn(x))} r="5" fill="#df9b4e"/>{next!==null&&<><path d={`M${cx(x)} ${cy(fn(x))}L${cx(next)} ${cy(fn(next))}`} stroke="#315b7b" strokeWidth="3"/><circle cx={cx(next)} cy={cy(fn(next))} r="5" fill="#315b7b"/></>}</svg>}
export function GradientComparison(){const[x,setX]=useState(2),[applied,setApplied]=useState(false);const gl=2*x,gj=-2*(x-1),left=x-rate*gl,right=x+rate*gj;return <Page title="同样改权重，为什么这里用加号？" subtitle="拖动示意权重，点击更新：比较损失下降与回报上升。" takeaway="迷宫得分来自实际行动，怎样求出期望回报的梯度 ∇θJ？"><div className="pg-gc-page"><div className="pg-gc-columns"><section><T small>一般训练 · 希望损失更小</T><F latex={String.raw`L(\theta)=\theta^2`}/><Curve kind="loss" x={x} next={applied?left:null}/><div className="pg-gc-equation"><F latex={String.raw`\theta_{\mathrm{new}}=\theta-\alpha\nabla_\theta L`}/></div><T small>损失梯度：{gl.toFixed(2)} · 沿反方向更新</T><H>损失 { (x*x).toFixed(2)}{applied?` → ${(left*left).toFixed(2)}`:''}</H><T small>权重：{x.toFixed(2)}{applied?` → ${left.toFixed(2)}`:''}</T></section><section className="pg-gc-policy"><T small>策略训练 · 希望期望回报更大</T><F latex={String.raw`J(\theta)=5-(\theta-1)^2`}/><Curve kind="return" x={x} next={applied?right:null}/><div className="pg-gc-equation"><F latex={String.raw`\theta_{\mathrm{new}}=\theta+\alpha\nabla_\theta J`}/></div><T small>回报梯度：{gj.toFixed(2)} · 沿梯度方向更新</T><H>回报 {(5-(x-1)**2).toFixed(2)}{applied?` → ${(5-(right-1)**2).toFixed(2)}`:''}</H><T small>权重：{x.toFixed(2)}{applied?` → ${right.toFixed(2)}`:''}</T></section></div><div className="pg-gc-interaction"><RangeControl label={`示意权重 θ：${x.toFixed(1)}`} min={-2} max={3} step={.1} value={x} onChange={e=>{setX(Number(e.target.value));setApplied(false);}}/><Controls><Button variant="primary" disabled={applied} onClick={()=>setApplied(true)}>同时更新一步</Button><Button onClick={()=>{setX(2);setApplied(false);}}>重置</Button></Controls></div><T small>梯度指向函数局部增大的方向。α = 0.1；橙点更新前，蓝点更新后。示意曲线：横轴权重，纵轴损失 / 回报。</T></div></Page>}
