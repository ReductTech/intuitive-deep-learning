.pg-tr-sampling-scale{position:relative;min-width:0;max-width:100%;padding-bottom:48px}.pg-tr-sampling-bar{display:flex;height:46px;min-width:0;max-width:100%;border-radius:10px;border:1px solid var(--ui-border)}.pg-tr-sampling-segment{display:flex;align-items:center;justify-content:center;min-width:0;max-width:100%;background:#e3edf5}.pg-tr-sampling-segment.dir-1{background:#d6e8e6}.pg-tr-sampling-segment.dir-2{background:#f0e6d2}.pg-tr-sampling-segment.dir-3{background:#e0e0ef}.pg-tr-sampling-segment.is-chosen{outline:3px solid var(--ui-accent);outline-offset:-3px}.pg-tr-sampling-marker{position:absolute;top:46px;transform:translateX(-50%);display:grid;justify-items:center;min-width:0;max-width:100%;white-space:nowrap;gap:0}.pg-tr-case-wrap .pg-tr-stack{gap:8px}.pg-tr-case-wrap .edu-math-block{padding:2px;margin:0}.pg-tr-training-curve{display:grid;grid-template-columns:minmax(0,.12fr) minmax(0,1fr);gap:8px;align-items:center;height:74px;min-width:0;max-width:100%}.pg-tr-training-curve>div{height:100%;display:flex;flex-direction:column;justify-content:space-between;min-width:0;max-width:100%}.pg-tr-training-curve svg{width:100%;height:74px;min-width:0;max-width:100%}.pg-tr-numeric .pg-tr-outputs>div{gap:3px;padding:8px 4px}.pg-tr-numeric .pg-tr-stack{gap:10px}

.pg-tr-sampling-marker{width:150px}.pg-tr-sampling-marker>.ui-typography{white-space:nowrap}.pg-tr-flow-live .pg-world{width:260px}.pg-tr-training-curve,.pg-tr-training-curve svg{height:50px}.pg-tr-flow-live .pg-controls .edu-btn{padding-top:7px;padding-bottom:7px}

.pg-tr-sampling-lesson .pg-tr-sampling-left{gap:26px}.pg-tr-sampling-lesson .pg-tr-board .pg-world{width:340px}.pg-tr-sampling-lesson .pg-tr-sampling-right{gap:10px}.pg-tr-draw-scale{min-width:0;max-width:100%}.pg-tr-draw-bar{display:flex;position:relative;height:68px;border:1px solid var(--ui-border);border-radius:8px;min-width:0;max-width:100%}.pg-tr-draw-segment{display:grid;align-content:center;justify-items:center;gap:0;min-width:0;max-width:100%;background:#e3edf5}.pg-tr-draw-segment.dir-1{background:#d6e8e6}.pg-tr-draw-segment.dir-2{background:#f0e6d2}.pg-tr-draw-segment.dir-3{background:#e0e0ef}.pg-tr-draw-segment.is-chosen{outline:3px solid var(--ui-accent);outline-offset:-3px}.pg-tr-draw-line{position:absolute;top:0;bottom:0;width:0;border-left:3px solid #213951;pointer-events:none}.pg-tr-draw-ticks{position:relative;height:34px;min-width:0;max-width:100%;margin-top:4px}.pg-tr-draw-ticks>div{position:absolute;top:0;min-width:0;max-width:100%;white-space:nowrap}.pg-tr-draw-ticks .ui-typography{white-space:nowrap}.pg-tr-draw-result{padding:12px 16px;min-width:0;max-width:100%;border-left:4px solid var(--ui-accent);background:var(--ui-bg-soft);border-radius:8px}

.pg-tr-draw-line{top:auto;bottom:-10px;height:10px}

.pg-tr-draw-bar{height:88px}.pg-tr-sampling-lesson .pg-tr-sampling-right{gap:8px}

.pg-tr-example-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;min-width:0;max-width:100%}.pg-tr-example-pair>div{display:grid;gap:4px;justify-items:center;padding:12px;background:var(--ui-bg-soft);border-radius:10px;min-width:0;max-width:100%}.pg-tr-weight-connection{display:flex;align-items:center;justify-content:center;gap:14px;padding:16px;background:var(--ui-bg-soft);border-radius:10px;min-width:0;max-width:100%}.pg-tr-weight-connection>*{min-width:0;max-width:100%}.pg-tr-one-weight .pg-tr-stack{gap:12px}.pg-tr-one-weight .edu-math-block{padding:4px;margin:0}.pg-tr-flow-live .pg-hero-marker.is-fox,.pg-tr-flow-live .pg-fox-avatar{width:64px;height:64px}.pg-tr-live-stage-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;min-width:0;max-width:100%}.pg-tr-live-stage-strip>div{padding:10px 4px;text-align:center;border-radius:8px;background:var(--ui-bg-soft);min-width:0;max-width:100%}.pg-tr-live-stage-strip .is-current{outline:2px solid var(--ui-accent);background:#dbe8f2}.pg-tr-flow-live .pg-tr-flow-calculation{min-height:132px;gap:8px}.pg-tr-live-actions{display:grid;gap:8px;min-width:0;max-width:100%}.pg-tr-live-actions .pg-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.pg-tr-live-probs>div{min-height:106px;align-content:center}.pg-tr-live-probs .ui-typography{white-space:nowrap}.pg-tr-flow-live .pg-tr-flow-right{gap:10px}.pg-tr-flow-live .pg-tr-board .pg-world{width:250px}.pg-tr-flow-live>.pg-tr-stack:first-child{gap:8px}

.pg-tr-training-curve,.pg-tr-training-curve svg{height:84px}.pg-tr-curve-empty{height:84px;display:grid;align-items:center;min-width:0;max-width:100%}.pg-tr-flow-live .pg-tr-board .pg-world{width:230px}

.pg-tr-visual-sampling .pg-tr-draw-bar{height:112px}.pg-tr-visual-sampling .pg-tr-sampling-right{gap:16px}.pg-tr-sampling-facts{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.15fr) minmax(0,1fr) minmax(0,.15fr) minmax(0,1fr);gap:8px;align-items:center;padding:18px 12px;background:var(--ui-bg-soft);border-radius:12px;min-width:0;max-width:100%}.pg-tr-sampling-facts>div{display:grid;gap:6px;justify-items:center;min-width:0;max-width:100%}.pg-tr-sampling-facts>.ui-typography{justify-self:center;min-width:0;max-width:100%}.pg-tr-visual-sampling .pg-tr-draw-ticks{height:34px}

.pg-tr-training-progress{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:6px;background:var(--ui-bg-soft);border-radius:12px;min-width:0;max-width:100%}.pg-tr-training-progress>div{padding:8px 10px;text-align:center;border-radius:8px;min-width:0;max-width:100%}.pg-tr-training-progress .is-current{background:#294969;color:white;box-shadow:0 2px 4px rgba(20,45,70,.12)}.pg-tr-training-progress .is-current .ui-typography{color:inherit}.pg-tr-course-wrap{height:100%;display:grid;grid-template-rows:auto minmax(0,1fr);gap:12px;min-height:0;min-width:0;max-width:100%}.pg-tr-course-wrap .pg-tr-return-practice .pg-world{width:330px}.pg-tr-course-wrap .pg-tr-one-weight .pg-world{width:310px}.pg-tr-course-wrap .pg-tr-one-weight .pg-tr-stack{gap:8px}.pg-tr-course-wrap .pg-tr-flow-live .pg-world{width:210px}.pg-tr-course-wrap .pg-tr-flow-live>.pg-tr-stack:first-child{gap:6px}

.pg-tr-course-wrap .pg-tr-flow-live>.pg-tr-stack:first-child{gap:4px}.pg-tr-course-wrap .pg-tr-flow-live .pg-tr-records{gap:4px}

.pg-tr-course-wrap .pg-tr-one-weight .pg-world{width:280px}.pg-tr-course-wrap .pg-tr-return-practice .pg-tr-stack{gap:6px}.pg-tr-course-wrap .pg-tr-return-parts{padding:10px}

.pg-tr-return-calculation{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.12fr) minmax(0,1fr) minmax(0,.12fr) minmax(0,1fr);gap:8px;align-items:center;min-width:0;max-width:100%;padding:14px 0}.pg-tr-return-calculation>div{min-width:0;max-width:100%;display:grid;gap:8px;justify-items:center;padding:14px 6px;background:var(--ui-bg-soft);border-radius:10px;text-align:center}.pg-tr-return-calculation>.ui-typography{min-width:0;max-width:100%;justify-self:center}.pg-tr-return-calculation .is-result{background:#dce9f2;outline:2px solid var(--ui-accent)}

.pg-tr-training-dashboard .pg-tr-dashboard-metrics{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:8px 10px;background:var(--ui-bg-soft);border-radius:10px;min-width:0;max-width:100%}.pg-tr-dashboard-metrics>*{min-width:0;max-width:100%}.pg-tr-course-wrap .pg-tr-training-dashboard .pg-tr-board .pg-world{width:240px}.pg-tr-training-dashboard .pg-tr-dashboard-return .edu-math-block{padding:0;margin:0}.pg-tr-training-dashboard .pg-tr-flow-right{gap:10px}.pg-tr-training-dashboard .pg-tr-stack{gap:10px}.pg-tr-training-dashboard .pg-tr-live-probs>div{min-height:106px}

.pg-tr-reinforce-intro{height:100%;display:grid;align-content:center;gap:28px;min-width:0;max-width:100%}.pg-tr-reinforce-intro-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;min-width:0;max-width:100%}.pg-tr-reinforce-intro-cards>div{display:grid;gap:18px;align-content:start;min-width:0;max-width:100%;padding:22px 24px;background:var(--ui-bg-soft);border-radius:14px}.pg-tr-reinforce-intro *{min-width:0;max-width:100%}.pg-tr-reinforce-intro .edu-math-block{margin:0;padding:4px}

.pg-tr-baseline-bridge{grid-template-columns:minmax(0,.9fr) minmax(0,1.2fr);gap:38px}.pg-tr-baseline-bridge .pg-tr-stack{gap:12px}.pg-tr-baseline-bridge .pg-world{width:310px}.pg-tr-baseline-bridge .edu-math-block{padding:4px;margin:0}.pg-tr-baseline-values{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.1fr) minmax(0,1fr) minmax(0,.1fr) minmax(0,1fr);gap:8px;align-items:center;min-width:0;max-width:100%}.pg-tr-baseline-values>div{display:grid;gap:6px;justify-items:center;text-align:center;min-width:0;max-width:100%;padding:14px 6px;background:var(--ui-bg-soft);border-radius:10px}.pg-tr-baseline-values>.ui-typography{justify-self:center;min-width:0;max-width:100%}.pg-tr-baseline-values .is-result{background:#dce9f2;outline:2px solid var(--ui-accent)}

.pg-tr-baseline-bridge .edu-range{width:100%;max-width:100%;margin-left:0;margin-right:0;box-sizing:border-box}

.pg-tr-sampling-left .pg-tr-strip{display:flex;justify-content:center;gap:8px}.pg-tr-sampling-left .pg-tr-strip>div{flex:0 1 auto;padding:6px 16px;min-width:0;max-width:100%}

.pg-tr-curve-plot{min-width:0;max-width:100%;display:grid;gap:2px}.pg-tr-curve-axis{display:flex;justify-content:space-between;gap:12px}

.pg-tr-training-curve{height:84px;align-items:start}.pg-tr-training-curve svg{height:54px;flex-shrink:0}.pg-tr-training-curve>div:first-child{height:54px}.pg-tr-training-curve>.pg-tr-curve-plot{height:84px;display:grid;grid-template-rows:54px auto;gap:2px}

.pg-tr-training-curve{height:128px}.pg-tr-training-curve svg,.pg-tr-training-curve>div:first-child{height:84px}.pg-tr-training-curve>.pg-tr-curve-plot{height:128px;grid-template-columns:minmax(0,1fr);grid-template-rows:84px auto;justify-content:stretch}
