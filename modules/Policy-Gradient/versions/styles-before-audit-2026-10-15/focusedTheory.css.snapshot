.pg-ft-page,.pg-ft-steps{height:100%;display:grid;align-content:center;gap:24px}
.pg-ft-page *,.pg-ft-derive *,.pg-ft-steps *{min-width:0;max-width:100%;box-sizing:border-box}
.pg-ft-chain{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr);gap:20px;align-items:center}
.pg-ft-chain>div{display:grid;gap:10px;text-align:center;padding:16px;background:var(--ui-bg-muted,#edf2f8);border-radius:12px}
.pg-ft-central{display:grid;gap:12px;justify-items:center;padding:20px 0}
.pg-ft-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px}.pg-ft-pair>div{display:grid;gap:10px;border-top:2px solid #ccdbe5;padding-top:16px}
.pg-ft-derive{height:100%;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:14px 44px;align-content:center}
.pg-ft-scene{display:grid;align-content:center;justify-items:center;gap:12px}
.pg-ft-maze{width:100%;display:grid;justify-items:center}.pg-ft-maze .pg-world{width:280px}.pg-ft-maze .pg-hero-marker.is-fox,.pg-ft-maze .pg-fox-avatar{width:65px;height:65px}
.pg-ft-equations{display:grid;gap:16px;align-content:center}.pg-ft-equations>div{display:grid;gap:6px}
.pg-ft-identity{border-top:1px solid #cddbe5;padding-top:10px;display:grid;gap:4px}
.pg-ft-result{grid-column:1/-1;display:grid;gap:6px;padding:10px 20px;background:#edf2f8;border-radius:12px}
.pg-ft-step-body{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.5fr);gap:36px;align-items:center}
.pg-ft-step-content{display:grid;gap:12px}.pg-ft-timeline{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.pg-ft-timeline .edu-btn{display:grid;gap:6px;padding:12px 4px}.pg-ft-timeline .is-past{opacity:.4}.pg-ft-timeline .is-future{background:#e4edf5}.pg-ft-timeline .is-active{outline:2px solid #315b7b;background:#d1e1ec}
.pg-ft-algorithm{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.pg-ft-algorithm>div{display:grid;grid-template-rows:auto 170px auto;align-items:center;gap:16px;padding:14px 10px;border-top:3px solid #aebfce}.pg-ft-algorithm .pg-world{width:165px;padding:8px}.pg-ft-algorithm .pg-hero-marker.is-fox,.pg-ft-algorithm .pg-fox-avatar{width:38px;height:38px}
.pg-ft-returns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.pg-ft-returns>div{display:grid;gap:6px;text-align:center;padding:10px 4px;background:#edf2f8;border-radius:8px}.pg-ft-update-icon{display:grid;gap:12px;justify-items:center}

.pg-ft-page{gap:16px}.pg-ft-steps{gap:10px}.pg-ft-step-content{gap:6px}.pg-ft-timeline .edu-btn{padding:8px 4px;gap:4px;border-radius:12px}.pg-ft-steps .pg-ft-identity{padding-top:6px}
.pg-ft-maze.pg-tr-board .pg-world{width:280px}.pg-ft-maze.pg-tr-board .pg-hero-marker.is-fox,.pg-ft-maze.pg-tr-board .pg-fox-avatar{width:65px;height:65px}.pg-ft-algorithm .pg-ft-maze.pg-tr-board .pg-world{width:165px;padding:8px}.pg-ft-algorithm .pg-ft-maze.pg-tr-board .pg-hero-marker.is-fox,.pg-ft-algorithm .pg-ft-maze.pg-tr-board .pg-fox-avatar{width:38px;height:38px}
.pg-ft-algorithm>div{grid-template-rows:auto 200px auto;gap:10px}.pg-ft-returns{gap:6px}.pg-ft-returns>div{gap:4px;padding:4px}.pg-ft-algorithm .pg-ft-maze.pg-tr-board .pg-world{width:185px}

.pg-ft-algorithm-page{gap:8px}

.pg-ft-steps .pg-ft-timeline .edu-btn.is-current{background:#d1e1ec;outline:2px solid #315b7b}

.pg-ft-route-select{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;width:100%}.pg-ft-derive .pg-ft-maze.pg-tr-board .pg-world{width:240px}.pg-ft-derive .pg-ft-scene{gap:8px}
