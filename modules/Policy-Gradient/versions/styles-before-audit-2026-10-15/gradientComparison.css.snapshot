.pg-gc-page{height:100%;display:grid;gap:12px;align-content:center}
.pg-gc-page *{min-width:0;max-width:100%;box-sizing:border-box}
.pg-gc-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px}
.pg-gc-columns>section{display:grid;gap:6px;padding:14px 24px;border-top:4px solid var(--ui-border,#cbd7e2);background:var(--ui-bg-soft,#f2f5f9);border-radius:4px 4px 12px 12px}
.pg-gc-columns>section.pg-gc-policy{border-color:var(--ui-accent,#315b7b)}
.pg-gc-columns svg{width:100%;height:120px;max-width:100%}
.pg-gc-equation{padding:4px 0;border-top:1px solid var(--ui-border,#cbd7e2);border-bottom:1px solid var(--ui-border,#cbd7e2)}
.pg-gc-interaction{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:36px;align-items:center}.pg-gc-interaction .edu-range{margin:0}
