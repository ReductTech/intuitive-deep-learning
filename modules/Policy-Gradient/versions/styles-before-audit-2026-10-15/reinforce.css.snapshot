.pg-re-scene{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);gap:46px;align-items:center;width:100%;height:100%;min-width:0}.pg-re-scene>*{min-width:0;max-width:100%}.pg-re-scene.is-wide{grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr)}.pg-re-stack{display:grid;gap:18px;align-content:center;min-width:0}.pg-re-stack.is-top{align-content:start}.pg-re-center{display:grid;justify-items:center;align-content:center;gap:22px;height:100%}.pg-re-lead{display:grid;gap:10px}.pg-re-eyebrow{display:inline-flex;align-items:center;gap:9px;width:max-content;max-width:100%;border-radius:999px;padding:8px 14px;background:rgba(var(--ui-accent-rgb),.1);color:var(--ui-accent)}.pg-re-panel{min-width:0;padding:25px;border:1px solid var(--ui-border);border-radius:24px;background:var(--ui-bg-card);box-shadow:0 18px 46px rgba(30,56,94,.08)}.pg-re-panel.is-warm{background:linear-gradient(135deg,rgba(var(--ui-accent-alt-rgb),.1),var(--ui-bg-card) 58%)}.pg-re-panel.is-blue{background:linear-gradient(135deg,rgba(var(--ui-accent-rgb),.12),var(--ui-bg-card) 58%)}.pg-re-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.pg-re-pair>*{min-width:0}.pg-re-chips{display:flex;flex-wrap:wrap;gap:9px}.pg-re-chip{padding:8px 12px;border-radius:999px;background:var(--ui-bg-soft);border:1px solid var(--ui-border)}.pg-re-compare{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.pg-re-compare>div{display:grid;justify-items:center;gap:4px;min-width:0;padding:14px 5px;border-radius:12px;background:var(--ui-bg-soft)}.pg-re-compare>div.is-picked{background:rgba(var(--ui-accent-alt-rgb),.15);outline:2px solid var(--ui-accent-alt)}.pg-re-arrowline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;align-items:center}.pg-re-arrowline>div{padding:16px 10px;text-align:center;border-radius:14px;background:var(--ui-bg-soft);min-width:0}.pg-re-meter{height:20px;display:flex;overflow:hidden;border-radius:999px;background:var(--ui-bg-soft)}.pg-re-meter>span{height:100%;border-right:2px solid var(--ui-bg-card);transition:width .35s ease}.pg-re-meter .up{background:#f3a46a}.pg-re-meter .down{background:#8fa9d2}.pg-re-meter .left{background:#aec0d9}.pg-re-meter .right{background:#4d75c3}.pg-re-metric{display:grid;gap:5px;padding:17px;border-radius:14px;background:var(--ui-bg-soft);min-width:0}.pg-re-metric.is-active{outline:2px solid var(--ui-accent)}.pg-re-number{font-variant-numeric:tabular-nums;color:var(--ui-accent)}.pg-re-timeline{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;width:100%}.pg-re-timeline button{min-width:0;display:grid;justify-items:center;gap:5px;padding:10px 4px;border:1px solid var(--ui-border);border-radius:11px;background:var(--ui-bg-soft);color:var(--ui-text);cursor:pointer}.pg-re-timeline button:disabled{opacity:.45;cursor:default}.pg-re-timeline button.is-active{outline:2px solid var(--ui-accent-alt);background:rgba(var(--ui-accent-alt-rgb),.12)}.pg-re-timeline button.is-wall{border-color:var(--ui-danger)}.pg-re-code{display:grid;gap:3px;border-radius:16px;background:#182743;padding:20px 24px;color:#e7f0ff;max-width:100%;overflow:hidden}.pg-re-code-line{display:grid;grid-template-columns:25px minmax(0,1fr);gap:12px;padding:5px 8px;border-radius:8px;white-space:pre-wrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.pg-re-code-line.is-active{background:#375581}.pg-re-code-line>span:first-child{color:#8ea8cf}.pg-re-network{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:12px}.pg-re-network>div{display:grid;justify-items:center;gap:8px;min-width:0;padding:18px 10px;border-radius:17px;background:var(--ui-bg-soft);text-align:center}.pg-re-network .pg-re-network-connector{background:none;padding:0;color:var(--ui-accent)}.pg-re-option-row{display:flex;gap:9px;flex-wrap:wrap}.pg-re-option-row .edu-btn{min-height:42px}.pg-re-progress{height:10px;overflow:hidden;border-radius:999px;background:var(--ui-bg-soft)}.pg-re-progress span{display:block;height:100%;background:var(--ui-accent);transition:width .3s}.pg-re-highlight{border-left:5px solid var(--ui-accent-alt);background:rgba(var(--ui-accent-alt-rgb),.1);padding:14px 18px;border-radius:0 12px 12px 0}.pg-re-ref{display:grid;gap:8px;padding:14px 18px;border-top:1px solid var(--ui-border)}
.pg-world{width:min(100%,550px);aspect-ratio:1;margin:auto;border-radius:30px;padding:17px;background:linear-gradient(145deg,#2d5360,#1e354a);box-shadow:0 24px 55px rgba(28,51,70,.21),inset 0 0 0 3px rgba(255,255,255,.14)}.pg-world.is-large{width:min(69vh,640px);max-width:640px}.pg-world-grid{width:100%;height:100%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(4,minmax(0,1fr));gap:9px}.pg-tile{position:relative;min-width:0;min-height:0;overflow:hidden;border-radius:17px;background:linear-gradient(145deg,#f7f3df,#e3eacb);box-shadow:inset 0 -8px 0 rgba(57,87,75,.09),0 4px 8px rgba(15,28,30,.15)}.pg-tile.is-visited{background:linear-gradient(145deg,#edf7dc,#cee9d9)}.pg-tile.is-wall{background:repeating-linear-gradient(0deg,#536b73 0 23px,#465d67 23px 26px);border:3px solid #38505b;box-shadow:inset 0 10px 14px rgba(255,255,255,.12),inset 0 -14px 18px rgba(13,34,43,.23),0 6px 8px rgba(14,31,37,.2)}.pg-tile.is-goal{background:radial-gradient(circle at 50% 45%,#fff1a9,#99d8ae 75%);box-shadow:inset 0 0 0 3px #65b58a,0 0 22px rgba(245,216,99,.5)}.pg-tile.is-focus{outline:5px solid #ff9f69;outline-offset:-6px}.pg-tile-name{position:absolute;top:9px;left:9px;z-index:2;padding:4px 8px;border-radius:99px;background:rgba(255,255,255,.83);color:#294557;font-size:13px;font-weight:700}.pg-goal-icon{position:absolute;left:50%;top:53%;transform:translate(-50%,-50%);font-size:70px;color:#efbd3a;text-shadow:0 0 20px #fff}.pg-hero{position:absolute;z-index:3;left:50%;top:53%;width:56px;height:56px;transform:translate(-50%,-50%);border-radius:45% 45% 39% 39%;background:linear-gradient(145deg,#ffbd72,#ea744d);box-shadow:inset -7px -7px 0 rgba(147,63,43,.15),0 8px 0 rgba(100,65,45,.2),0 11px 14px rgba(33,60,48,.2);animation:pg-hero-bob 1.8s ease-in-out infinite}.pg-hero:before,.pg-hero:after{content:'';position:absolute;top:18px;width:7px;height:10px;border-radius:50%;background:#33485a}.pg-hero:before{left:17px}.pg-hero:after{right:17px}.pg-hero-eye{position:absolute;left:50%;top:34px;width:13px;height:6px;transform:translateX(-50%);border-bottom:2px solid #994e42;border-radius:50%}.pg-footprint{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);font-size:42px;color:rgba(84,132,116,.45)}.pg-world.is-bumping .pg-hero{animation:pg-bump .35s ease-in-out}.pg-direction-pad{display:grid;grid-template-columns:repeat(3,56px);grid-template-rows:repeat(3,46px);gap:4px;justify-content:center}.pg-direction-pad .edu-btn{min-width:0;min-height:0;padding:0}.pg-direction-pad .edu-btn:nth-child(1){grid-column:2;grid-row:1}.pg-direction-pad .edu-btn:nth-child(2){grid-column:2;grid-row:3}.pg-direction-pad .edu-btn:nth-child(3){grid-column:1;grid-row:2}.pg-direction-pad .edu-btn:nth-child(4){grid-column:3;grid-row:2}.pg-game-active{overflow:hidden}.pg-game-overlay{position:fixed;z-index:2147483000;inset:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;justify-items:center;align-items:center;gap:8px;padding:20px 32px;background:radial-gradient(circle at 50% 35%,#356d75,#182d43 78%);color:#f6f5e9}.pg-game-overlay:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.18;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:28px 28px}.pg-game-overlay>*{z-index:1}.pg-game-top{display:flex;width:min(100%,1080px);align-items:center;justify-content:space-between;gap:20px}.pg-game-stats{display:flex;gap:24px}.pg-game-bottom{display:grid;justify-items:center;gap:10px}.pg-game-actions{display:flex;gap:10px}.pg-game-overlay .edu-btn{background:#f6f1df;color:#203b4b;border-color:#e9e0c8}.pg-game-overlay .edu-btn:hover{background:#fff}.pg-game-overlay .edu-btn:disabled{opacity:.5}.pg-game-overlay .edu-btn.edu-btn-primary{background:#efae67;color:#213643;border-color:#efae67}
@keyframes pg-hero-bob{50%{transform:translate(-50%,-55%)}}@keyframes pg-bump{25%{transform:translate(-50%,-62%)}55%{transform:translate(-50%,-45%)}}@media(prefers-reduced-motion:reduce){.pg-hero{animation:none}.pg-world.is-bumping .pg-hero{animation:none}}
.pg-re-training-chart{display:flex;align-items:end;gap:5px;height:108px;margin-top:12px;border-bottom:2px solid var(--ui-border-strong)}.pg-re-training-chart>span{min-width:4px;flex:1;background:linear-gradient(180deg,#63a5c7,#4672ad);border-radius:4px 4px 0 0}
.pg-re-center .pg-world{width:min(100%,490px)}.pg-re-formula .pg-world{width:min(100%,425px)}.pg-re-formula .pg-re-panel .edu-math-formula{max-width:100%}
.pg-re-formula .pg-world{width:min(100%,350px)}
.pg-game-overlay .pg-world.is-large{width:min(54vh,600px);max-width:min(54vh,600px)}.pg-game-overlay{gap:4px;padding:14px 28px}.pg-game-bottom{gap:5px}.pg-game-overlay .pg-direction-pad{grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,38px)}
.pg-world-grid{position:relative}.pg-hero-marker{position:absolute;z-index:5;width:56px;height:56px;transform:translate(-50%,-50%);transition:left .48s cubic-bezier(.2,.75,.25,1),top .48s cubic-bezier(.2,.75,.25,1);pointer-events:none}.pg-hero-marker .pg-hero{position:relative;display:block;left:auto;top:auto;transform:none}.pg-world.is-bumping .pg-hero-marker .pg-hero{animation:pg-bump-contained .35s ease-in-out}@keyframes pg-bump-contained{25%{transform:translateY(-10px)}55%{transform:translateY(5px)}}.pg-re-scene:has(.pg-re-timeline) .pg-world{width:min(100%,425px)}.pg-re-scene:has(.pg-re-timeline) .pg-re-stack{gap:11px}.pg-re-scene:has(.pg-re-timeline) .pg-re-metric{padding:11px}
.pg-hero{animation:none}.pg-tile.is-wall{display:grid;place-items:center;background:repeating-linear-gradient(0deg,#4c626a 0 20px,#334a54 20px 24px);border:4px solid #263e49}.pg-wall-label{position:relative;z-index:2;padding:6px 7px;border-radius:8px;background:#203943;color:#fff8e5;text-align:center;letter-spacing:.04em;box-shadow:0 3px 8px rgba(0,0,0,.2)}.pg-tile.is-unknown{background:linear-gradient(145deg,#e2e7e4,#c8d6d2);box-shadow:inset 0 0 0 2px rgba(255,255,255,.3),inset 0 -8px 0 rgba(49,76,76,.12)}.pg-unknown-mark{position:absolute;inset:0;display:grid;place-items:center;color:#809998;font-size:42px;font-weight:700}.pg-world.is-exploring .pg-tile.is-visited{background:linear-gradient(145deg,#f7f3df,#e3eacb)}.pg-world.is-exploring .pg-tile.is-goal{background:radial-gradient(circle at 50% 45%,#fff1a9,#99d8ae 75%)}.pg-game-overlay .pg-game-bottom>.edu-typography:nth-child(2){font-size:18px;color:#d4e9e6}.pg-game-overlay .pg-world.is-large{width:min(51vh,580px);max-width:min(51vh,580px)}
.pg-re-explore{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:44px;align-items:center;width:100%;height:100%;outline:none}.pg-re-explore .pg-world{width:min(100%,420px)}.pg-re-explore-panel{display:grid;justify-items:start;align-content:center;gap:14px;min-width:0}.pg-re-explore-panel .pg-re-pair{width:100%}.pg-re-explore-panel .pg-re-metric{padding:12px 16px}.pg-re-explore-panel .pg-direction-pad{justify-content:start;margin-left:44px;grid-template-columns:repeat(3,52px);grid-template-rows:repeat(3,40px)}.pg-re-explore-panel .pg-game-actions{display:flex;flex-wrap:wrap;gap:10px}.pg-re-explore:focus-visible{outline:2px solid var(--ui-accent);outline-offset:6px;border-radius:12px}
.pg-re-explore .pg-world{width:min(100%,475px)}.pg-re-explore-panel .pg-direction-pad{margin-left:48px;grid-template-columns:repeat(3,64px);grid-template-rows:repeat(3,52px)}.pg-re-explore:focus-visible{outline:none}
.pg-route-svg{position:absolute;inset:0;width:100%;height:100%;z-index:4;overflow:visible;pointer-events:none}.pg-route-svg polyline{fill:none;stroke-linecap:round;stroke-linejoin:round}.pg-route-glow{stroke:rgba(39,118,146,.28);stroke-width:5}.pg-route-line{stroke:#2c8aab;stroke-width:1.9}.pg-re-rules ol{list-style:none;display:grid;gap:10px;margin:0;padding:0;width:100%}.pg-re-rules li{display:grid;grid-template-columns:64px 1fr;gap:12px;align-items:center;padding:10px 13px;background:var(--ui-bg-soft);border:1px solid var(--ui-border);border-radius:12px;font-size:19px;line-height:1.35;color:var(--ui-text)}.pg-re-rules li strong{color:var(--ui-accent)}.pg-re-rules .pg-re-start{min-height:48px}.pg-re-route-log{display:flex;gap:7px;align-items:center;width:100%;max-width:100%;overflow-x:auto;white-space:nowrap;padding:3px 0 7px;color:var(--ui-text-muted);font-size:16px}.pg-re-route-log span{flex:none;padding:6px 9px;border-radius:9px;background:var(--ui-bg-soft);border:1px solid var(--ui-border)}.pg-re-route-log span.is-wall{background:#fff1e9;border-color:#e5a783;color:#9c4e29}.pg-re-route-log span.is-goal{background:#e7f5e9;border-color:#8cc69b;color:#286e43}.pg-re-explore-panel:not(.pg-re-rules){gap:10px}.pg-re-explore-panel:not(.pg-re-rules) .pg-re-metric{padding:9px 13px}
.pg-re-rules li{grid-template-columns:78px 1fr;padding:11px 15px;font-size:25px}.pg-re-route-log{font-size:18px}
.pg-re-explore-panel .pg-direction-pad{width:100%;margin:0;justify-content:center;grid-template-columns:repeat(3,84px);grid-template-rows:repeat(3,72px);gap:8px}.pg-re-explore-panel .pg-direction-pad .edu-btn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;border:2px solid #294c70;border-radius:16px;background:#315b82;color:#fff;box-shadow:0 7px 0 #1d3d5b,0 12px 20px rgba(26,57,87,.18);font-weight:700}.pg-re-explore-panel .pg-direction-pad .edu-btn:hover{background:#3b6d99;color:#fff}.pg-re-explore-panel .pg-direction-pad .edu-btn:active{transform:translateY(4px);box-shadow:0 3px 0 #1d3d5b}.pg-re-explore-panel .pg-direction-pad .edu-btn:disabled{opacity:.55}
.pg-hero-marker.is-fox{width:70px;height:70px}.pg-fox-avatar{display:block;width:70px;height:70px;object-fit:contain;filter:drop-shadow(0 5px 3px rgba(61,66,50,.24));transition:transform .18s ease-out}.pg-world.is-bumping .pg-fox-avatar{animation:pg-fox-flash .32s ease-out}@keyframes pg-fox-flash{50%{filter:drop-shadow(0 5px 3px rgba(61,66,50,.24)) brightness(1.25)}}
.pg-hero-marker.is-fox{width:104px;height:104px}.pg-fox-avatar{width:104px;height:104px}.pg-re-explore-panel{gap:8px}.pg-re-explore-panel .pg-direction-pad{grid-template-rows:repeat(3,68px);gap:6px}.pg-re-explore-panel .pg-re-route-log{padding:0 0 3px}
.pg-hero-marker.is-fox{width:118px;height:118px}.pg-fox-avatar{width:118px;height:118px}

/* First-page exploration: one woodland scene, with the game objects on it. */
.pg-maze-adventure{position:relative;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);grid-template-rows:auto minmax(0,1fr) auto;column-gap:48px;row-gap:10px;padding:24px 72px 20px;border-radius:var(--ui-radius-lg);background-color:#f7f1e1;background-size:cover;background-position:center;box-shadow:inset 0 0 0 1px rgba(163,139,96,.2);isolation:isolate}
.pg-maze-adventure:before{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:linear-gradient(90deg,rgba(255,250,236,.12),rgba(255,250,236,.3));pointer-events:none}
.pg-adventure-rules{grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:22px;padding:9px 22px;border-radius:999px;background:rgba(255,253,244,.84);justify-self:center;box-shadow:0 3px 12px rgba(110,88,54,.06)}
.pg-rule-divider{width:1px;height:24px;background:rgba(129,108,70,.25)}
.pg-adventure-board{display:grid;align-items:center;justify-items:center;height:100%;min-height:0;padding:8px 0 14px}
.pg-maze-adventure .pg-world{width:min(100%,472px);padding:16px;border-radius:24px;background:linear-gradient(135deg,#d6ae72,#f0d2a1 35%,#b78349);box-shadow:0 12px 0 #a97b48,0 22px 26px rgba(84,68,41,.2),inset 0 0 0 2px #f3d6a7,inset 0 0 0 7px rgba(149,95,44,.16)}
.pg-maze-adventure .pg-world-grid{gap:7px;background:#bfa275;border-radius:12px}
.pg-maze-adventure .pg-tile{border-radius:11px;background:linear-gradient(135deg,#f5eaca,#e5d7b7);box-shadow:inset 0 2px 0 #fff9e5,inset 0 -5px 0 rgba(124,106,70,.12),0 2px 3px rgba(102,76,42,.16)}
.pg-maze-adventure .pg-tile.is-unknown{background:radial-gradient(ellipse at 25% 20%,rgba(249,253,231,.58),transparent 60%),linear-gradient(145deg,#d3dec0,#b6c7a0);box-shadow:inset 0 2px 0 rgba(251,255,236,.7),inset 0 -5px 0 rgba(83,108,65,.15)}
.pg-maze-adventure .pg-unknown-mark{color:#80946b;text-shadow:0 1px 0 rgba(255,255,255,.6)}
.pg-maze-adventure .pg-tile.is-visited{background:linear-gradient(145deg,#fff3d1,#e9d8b5)}
.pg-maze-adventure .pg-tile.is-goal{background:radial-gradient(circle at 50% 50%,#fff8c7,#e4d49b);box-shadow:inset 0 0 0 2px #d4b961,inset 0 -5px 0 rgba(169,139,63,.18)}
.pg-maze-adventure .pg-tile.is-wall{background:repeating-linear-gradient(0deg,#67746a 0 20px,#4e5d53 20px 24px);border-color:#45564b}
.pg-maze-adventure .pg-wall-label{background:#44584b;box-shadow:none}
.pg-maze-adventure .pg-tile-name{top:7px;left:7px;background:rgba(255,253,239,.85)}
.pg-maze-adventure .pg-hero-marker.is-fox,.pg-maze-adventure .pg-fox-avatar{width:124px;height:124px}
.pg-maze-adventure .pg-route-line{stroke:#327e89;stroke-width:2.1;stroke-dasharray:0}
.pg-maze-adventure .pg-route-glow{stroke:#fff7df;stroke-width:3.8}
.pg-adventure-controls{display:grid;justify-items:center;align-content:center;gap:12px;padding:8px 0;min-width:0}
.pg-adventure-scoreboard{display:flex;gap:30px;align-items:center;justify-content:center;width:100%;padding:12px 30px;background:rgba(255,252,238,.88);border:1px solid rgba(165,134,83,.32);border-radius:20px;box-shadow:0 6px 0 rgba(174,142,91,.14)}
.pg-adventure-scoreboard>div{display:grid;justify-items:center;min-width:110px;gap:2px}
.pg-score-divider{width:1px;height:54px;background:rgba(153,128,84,.25)}
.pg-adventure-feedback{display:grid;justify-items:center;gap:5px;min-height:64px;text-align:center;padding:4px 0}
.pg-adventure-pad{position:relative;padding:2px 20px 12px;border-radius:40px;background:radial-gradient(circle at 50% 50%,rgba(214,193,146,.3),transparent 66%)}
.pg-maze-adventure .pg-direction-pad{grid-template-columns:repeat(3,80px);grid-template-rows:repeat(3,63px);gap:7px}
.pg-maze-adventure .pg-direction-pad .edu-btn{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:0;min-height:0;padding:0;border-radius:17px;background:linear-gradient(145deg,#37677e,#24495f);color:#fff9e9;border:2px solid #24495f;box-shadow:0 6px 0 #183c51,0 9px 14px rgba(34,62,66,.19);transition:transform .12s,box-shadow .12s,background .12s}
.pg-maze-adventure .pg-direction-pad .edu-btn:hover{background:linear-gradient(145deg,#457c92,#315e76)}
.pg-maze-adventure .pg-direction-pad .edu-btn:active{transform:translateY(4px);box-shadow:0 2px 0 #183c51}
.pg-maze-adventure .pg-direction-pad .edu-btn:focus-visible{outline:3px solid #e6a849;outline-offset:5px}
.pg-maze-adventure .pg-direction-pad .edu-btn:disabled{opacity:.4;cursor:default}
.pg-pad-center{position:absolute;left:50%;top:50%;width:44px;height:44px;transform:translate(-50%,-60%);color:#b09a6e;pointer-events:none}
.pg-pad-center svg{width:100%;height:100%}
.pg-maze-adventure .pg-game-actions{justify-content:center;gap:10px;min-height:44px}
.pg-maze-adventure .pg-game-actions .edu-btn{background:rgba(255,252,241,.88);border-color:rgba(160,128,79,.4);border-radius:999px;padding:9px 20px}
.pg-maze-adventure .pg-game-actions .edu-btn--primary{background:var(--ui-accent-alt);color:#fff;border-color:var(--ui-accent-alt)}
.pg-adventure-footer{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:48px;padding:9px 18px;background:rgba(255,252,239,.86);border-radius:16px}
.pg-adventure-trail{display:flex;align-items:center;justify-content:flex-end;gap:5px;min-width:0}
.pg-adventure-trail>span{display:grid;place-items:center;min-width:34px;padding:3px 8px;border-radius:7px;color:#376e76;background:rgba(83,133,131,.1)}
.pg-adventure-trail>span.is-wall{color:#a05234;background:#f6dfc7}
.pg-adventure-trail>span.is-goal{color:#647b36;background:#e6ecc8}

.pg-maze-adventure .pg-direction-pad .edu-btn>span{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0}

.pg-treasure-icon{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);width:80%;height:76%;filter:drop-shadow(0 4px 2px rgba(126,93,36,.16))}

.pg-page:has(.pg-maze-adventure)>.edu-content-body{grid-template-rows:minmax(0,1fr);gap:0}
.pg-page:has(.pg-maze-adventure) .pg-main{grid-template-rows:minmax(0,1fr);align-items:stretch}
.pg-maze-adventure{min-height:0;row-gap:8px;padding-top:20px;padding-bottom:16px}
.pg-adventure-controls{gap:8px;padding:0;min-height:0}
.pg-adventure-scoreboard{padding:6px 24px}
.pg-adventure-feedback{padding:0;gap:3px;min-height:0}
.pg-maze-adventure .pg-direction-pad .edu-btn{min-height:0}

.pg-maze-adventure .pg-world{width:min(100%,510px)}

/* The opening scene covers the entire slide, including its shared heading. */
.pg-forest-page{background-color:#f7eed8;background-size:cover;background-position:center;border:0;border-radius:0;padding:46px 70px 38px;isolation:isolate}
.pg-forest-page>.edu-content-head{position:relative;z-index:1;padding:5px 12px 12px;background:linear-gradient(90deg,rgba(255,249,232,.9),rgba(255,249,232,.5) 75%,transparent);border-radius:14px}
.pg-forest-page .pg-maze-adventure{padding:6px 35px 10px;background:none;box-shadow:none;border-radius:0;column-gap:60px}
.pg-forest-page .pg-maze-adventure:before{display:none}
.pg-forest-page .pg-adventure-board{padding:10px 0 20px}
.pg-forest-page .pg-world{width:min(100%,520px)}
.pg-tile.is-wall,.pg-maze-adventure .pg-tile.is-wall{position:relative;display:grid;place-items:center;background:#424643;border:3px solid #777c77;box-shadow:inset 0 2px 5px rgba(255,255,255,.2),inset 0 -4px 8px rgba(0,0,0,.32),0 3px 5px rgba(30,32,29,.2)}
.pg-wall-bricks{position:absolute;inset:0;width:100%;height:100%;opacity:.95;pointer-events:none}
.pg-wall-label,.pg-maze-adventure .pg-wall-label{position:relative;z-index:2;display:grid;place-items:center;padding:6px 12px;border-radius:3px;background:rgba(44,46,44,.5);color:#fff;text-shadow:0 2px 2px rgba(0,0,0,.25);box-shadow:none}

/* Paired score cards keep score, steps and attempt together. */
.pg-adventure-scoreboard{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;gap:16px;width:100%;padding:0;background:none;border:0;border-radius:0;box-shadow:none}
.pg-adventure-scoreboard>.pg-adventure-stat{min-width:0;display:grid;justify-items:center;align-content:center;gap:3px;padding:12px 16px;background:linear-gradient(145deg,rgba(255,253,241,.96),rgba(251,241,213,.94));border:1px solid rgba(181,145,83,.4);border-radius:20px;box-shadow:0 5px 0 rgba(181,145,83,.16),0 10px 20px rgba(117,93,46,.07),inset 0 1px 0 #fffdf2}
.pg-adventure-scoreboard>.pg-adventure-stat:last-child{background:linear-gradient(145deg,rgba(250,253,237,.95),rgba(231,237,208,.95));border-color:rgba(144,162,112,.4)}
.pg-adventure-controls{gap:14px}
.pg-adventure-feedback{width:100%;min-height:50px;align-content:center;padding:4px 0;text-align:center}
.pg-adventure-feedback.is-success{padding:10px 14px;border:1px solid rgba(157,177,105,.5);border-radius:18px;background:linear-gradient(135deg,rgba(255,250,215,.95),rgba(233,244,207,.95));box-shadow:0 6px 18px rgba(122,141,77,.12)}
.pg-maze-adventure .pg-direction-pad{grid-template-rows:repeat(3,58px)}
.pg-adventure-pad{padding-bottom:8px}
.pg-adventure-footer{border:1px solid rgba(177,151,103,.24);box-shadow:0 4px 12px rgba(101,83,49,.06)}

.pg-adventure-controls:has(.pg-adventure-feedback.is-success){gap:22px}
.pg-adventure-controls:has(.pg-adventure-feedback.is-success) .pg-adventure-pad{display:none}
.pg-adventure-feedback.is-success{padding:20px 14px;gap:10px}

/* Reserve distinct bands for rules, play, and the complete action history. */
.pg-forest-page{padding:36px 60px 26px}
.pg-forest-page .pg-maze-adventure{grid-template-rows:94px minmax(0,1fr) 112px;gap:16px 46px;padding:0 26px;align-items:stretch}
.pg-adventure-rules{display:grid;grid-column:1/-1;justify-self:stretch;justify-items:center;align-content:center;gap:2px;padding:8px 18px;border-radius:18px}
.pg-adventure-rules-main{display:flex;align-items:center;justify-content:center;gap:18px}
.pg-forest-page .pg-adventure-board{padding:6px 0 18px;min-height:0}
.pg-forest-page .pg-world{width:min(100%,420px)}
.pg-adventure-controls{align-content:center;gap:10px;min-height:0}
.pg-adventure-scoreboard>.pg-adventure-stat{padding:7px 12px;gap:0}
.pg-adventure-control-bottom{display:flex;align-items:center;justify-content:center;gap:20px;min-width:0;width:100%}
.pg-adventure-control-bottom .pg-adventure-pad{flex:none;padding:0 0 6px}
.pg-adventure-control-bottom .pg-game-actions{display:grid;gap:12px;justify-items:center;align-content:center}
.pg-adventure-controls:has(.pg-adventure-feedback.is-success){gap:20px}
.pg-adventure-footer{display:grid;grid-template-columns:132px minmax(0,1fr);gap:16px;align-items:center;padding:12px 18px;margin:0;min-height:0;height:112px;border-radius:18px;background:rgba(255,253,241,.93)}
.pg-adventure-trail{display:grid;grid-template-columns:repeat(15,minmax(0,1fr));grid-template-rows:repeat(2,39px);gap:5px 6px;align-items:center;justify-content:start;min-width:0;height:83px}
.pg-adventure-trail>span{min-width:0;width:100%;padding:0 2px;white-space:nowrap;border-radius:7px}
.pg-adventure-trail.is-empty{display:flex;justify-content:flex-start;height:auto}

/* Let the forest texture show through the history strip. */
.pg-forest-page .pg-adventure-footer{background:linear-gradient(110deg,rgba(221,202,158,.68),rgba(236,221,182,.53));border:1px solid rgba(144,114,66,.3);box-shadow:inset 0 1px 0 rgba(255,247,218,.5),0 4px 12px rgba(92,71,37,.08)}
.pg-forest-page .pg-adventure-trail>span{background:rgba(69,112,109,.15)}
.pg-forest-page .pg-adventure-trail>span.is-wall{background:rgba(197,121,74,.2)}
.pg-forest-page .pg-adventure-trail>span.is-goal{background:rgba(127,155,65,.23)}

.pg-forest-page .pg-adventure-rules{justify-self:center;width:max-content;max-width:100%;padding:8px 26px;background:linear-gradient(110deg,rgba(223,204,162,.72),rgba(239,223,186,.58));border:1px solid rgba(148,119,73,.25);box-shadow:inset 0 1px 0 rgba(255,249,224,.4),0 3px 10px rgba(104,80,42,.05)}

/* Rules and board form one coherent left-hand panel. */
.pg-forest-page .pg-maze-adventure{grid-template-rows:minmax(0,1fr) 112px;gap:18px 34px}
.pg-forest-page .pg-adventure-maze-panel{display:grid;grid-template-rows:auto minmax(0,1fr);align-content:start;justify-items:center;gap:8px;padding:12px 20px 20px;height:100%;background:linear-gradient(130deg,rgba(224,204,159,.65),rgba(241,227,191,.49));border:1px solid rgba(150,120,72,.34);border-radius:24px;box-shadow:inset 0 1px 0 rgba(255,248,219,.7),0 7px 20px rgba(102,80,42,.08)}
.pg-forest-page .pg-adventure-maze-panel .pg-adventure-rules{grid-column:auto;display:grid;justify-self:stretch;justify-items:center;width:100%;max-width:100%;align-content:start;gap:0;padding:0 0 6px;border:0;border-radius:0;background:none;box-shadow:none;text-align:center}
.pg-adventure-maze-panel .pg-adventure-rules>h2{margin-bottom:3px}
.pg-forest-page .pg-adventure-maze-panel .pg-world{width:min(100%,400px);align-self:center;margin:0 0 8px}
.pg-adventure-controls{padding:12px 0;gap:18px}
.pg-adventure-scoreboard{gap:18px}
.pg-adventure-scoreboard>.pg-adventure-stat{border-radius:22px;padding:12px 14px}
.pg-adventure-control-bottom{gap:24px}
.pg-adventure-control-bottom .pg-game-actions .edu-btn{box-shadow:0 3px 0 rgba(153,122,72,.12)}
.pg-adventure-footer{border-radius:22px}
.pg-forest-page{padding:28px 60px 20px}
.pg-forest-page>.edu-content-head{padding-bottom:6px}
.pg-forest-page .pg-adventure-maze-panel{gap:18px}
.pg-adventure-control-bottom{display:grid;justify-items:center;gap:14px}
.pg-adventure-control-bottom .pg-game-actions{display:flex;justify-content:center;gap:14px}

/* A narrower, lighter exploration panel with a consistent sage-and-paper finish. */
.pg-forest-page .pg-maze-adventure{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:60px}
.pg-forest-page .pg-adventure-maze-panel{width:min(100%,560px);justify-self:center;padding:12px 24px 20px;border:1px solid rgba(117,133,95,.4);border-radius:20px;background:linear-gradient(145deg,rgba(250,244,222,.38),rgba(222,230,202,.22));box-shadow:inset 0 1px 0 rgba(255,252,235,.5),0 8px 20px rgba(76,90,58,.07)}
.pg-forest-page .pg-adventure-maze-panel .pg-adventure-rules{padding-bottom:10px;border-bottom:1px solid rgba(122,139,100,.25)}
.pg-forest-page .pg-adventure-controls{width:min(100%,560px);justify-self:center}
.pg-adventure-scoreboard>.pg-adventure-stat{border-radius:16px;border-color:rgba(165,144,102,.35);background:linear-gradient(145deg,rgba(250,244,222,.76),rgba(241,230,198,.55));box-shadow:inset 0 1px 0 rgba(255,251,232,.55),0 4px 12px rgba(103,86,49,.07)}
.pg-adventure-scoreboard>.pg-adventure-stat:last-child{background:linear-gradient(145deg,rgba(235,242,216,.76),rgba(218,228,193,.5));border-color:rgba(130,151,105,.35)}
.pg-forest-page .pg-adventure-footer{border-radius:16px;border-color:rgba(134,143,109,.33);background:linear-gradient(100deg,rgba(239,230,202,.43),rgba(225,232,202,.28));box-shadow:inset 0 1px 0 rgba(255,250,229,.4)}
.pg-forest-page>.edu-content-head{background:linear-gradient(90deg,rgba(250,244,222,.66),rgba(250,244,222,.3) 75%,transparent)}


.pg-vp-together{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:55px;height:100%;align-items:center}.pg-vp-together *{min-width:0;max-width:100%}.pg-vp-map.pg-maze-adventure{display:grid;grid-template-columns:1fr!important;grid-template-rows:auto auto auto!important;justify-items:center;gap:20px!important;padding:0!important;background:none}.pg-vp-map .pg-world{width:420px!important}.pg-vp-map .pg-tile[role=button]{cursor:pointer}.pg-vp-map .pg-tile[role=button]:hover{outline:3px solid var(--ui-accent);outline-offset:-3px}.pg-vp-map .pg-hero-marker{pointer-events:none}.pg-vp-dual{display:grid;gap:18px}.pg-vp-dual-lane{display:grid;gap:16px;padding:22px 26px;border:1px solid rgba(120,140,110,.35);border-left:5px solid var(--ui-accent);border-radius:18px;background:rgba(250,246,229,.78)}.pg-vp-dual-lane.is-policy{border-left-color:var(--ui-accent-alt);background:rgba(239,241,217,.82)}.pg-vp-dual-title,.pg-vp-dual-action{display:flex;align-items:center;justify-content:space-between;gap:12px}.pg-vp-dual-numbers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.pg-vp-dual-numbers>div{display:grid;justify-items:center;gap:5px;padding:10px 6px;border-radius:12px;background:rgba(255,251,235,.65)}
.pg-vp-dual{gap:12px}.pg-vp-dual-lane{padding:18px 24px;gap:12px}
.pg-vp-switch{display:grid;gap:24px;align-content:center}.pg-vp-switch>.pg-controls{justify-content:center}.pg-vp-switch .pg-vp-dual-lane{gap:24px;padding:30px}.pg-vp-switch .pg-vp-dual-numbers>div{cursor:pointer;padding:18px 8px;border:2px solid transparent}.pg-vp-switch .pg-vp-dual-numbers>div.is-highlighted{border-color:var(--ui-accent);background:rgba(var(--ui-accent-rgb),.15)}.pg-vp-map .pg-tile.is-candidate{outline:4px solid #e7a839;outline-offset:-5px;box-shadow:inset 0 0 0 8px rgba(247,194,74,.22)}
.pg-vp-switch .pg-vp-dual-numbers>div[aria-disabled=true]{cursor:default;opacity:.6}.pg-vp-switch .pg-vp-dual-numbers>div[aria-disabled=false]{cursor:pointer}.pg-vp-switch .pg-vp-dual-numbers>div[aria-disabled=false]:hover{background:rgba(var(--ui-accent-rgb),.23)}

.pg-vp-switch{gap:16px}.pg-vp-switch .pg-vp-dual-lane{gap:20px;padding:26px}.pg-vp-transition{display:grid;gap:14px;justify-items:center;text-align:center;padding:0 12px}.pg-vp-transition .pg-controls{justify-content:center}.pg-vp-switch>.ui-typography{opacity:.85}

/* Directional placement matches the exploration controls. */
.pg-vp-switch .pg-vp-dual-numbers{grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,76px);gap:8px;width:390px;justify-self:center}.pg-vp-switch .pg-vp-dual-numbers>div{display:flex;align-items:center;justify-content:center;gap:12px;padding:8px;border-radius:16px;border:2px solid #294c70;background:#315b82;box-shadow:0 5px 0 #1d3d5b;color:#fff}.pg-vp-switch .pg-vp-dual-numbers>div .ui-typography{color:inherit}.pg-vp-switch .pg-vp-dual-numbers>[data-direction=U]{grid-column:2;grid-row:1}.pg-vp-switch .pg-vp-dual-numbers>[data-direction=L]{grid-column:1;grid-row:2}.pg-vp-switch .pg-vp-dual-numbers>[data-direction=R]{grid-column:3;grid-row:2}.pg-vp-switch .pg-vp-dual-numbers>[data-direction=D]{grid-column:2;grid-row:3}.pg-vp-switch .pg-vp-dual-numbers>div.is-highlighted{background:#416d86;border-color:#ecc36f;box-shadow:0 5px 0 #1d3d5b,0 0 0 3px rgba(236,195,111,.3)}.pg-vp-switch .pg-vp-dual-numbers>div[aria-disabled=false]:hover{background:#416d86}.pg-vp-switch .pg-vp-dual-lane{padding:18px 24px;gap:12px}.pg-vp-switch{gap:10px}.pg-vp-transition{gap:8px}.pg-vp-switch .pg-vp-dual-numbers>div[aria-disabled=true]{opacity:.45}
.pg-vp-switch .pg-vp-dual-numbers{grid-template-rows:repeat(3,60px);width:420px}.pg-vp-switch .pg-vp-dual-lane{gap:10px}.pg-vp-switch .pg-vp-dual-numbers>div{gap:8px}
.pg-vp-switch .pg-vp-dual-numbers{width:540px}.pg-vp-switch .pg-vp-dual-numbers>div .ui-typography{white-space:nowrap;flex-shrink:0}

.pg-wall-letter{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none}.pg-wall-letter-center{display:grid;place-items:center;width:100%;height:100%}.pg-wall-letter .pg-wall-label{padding:4px 8px;letter-spacing:0}
