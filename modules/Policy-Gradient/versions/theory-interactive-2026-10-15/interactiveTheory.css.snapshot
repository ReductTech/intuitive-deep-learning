.pg-it-ascent{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:46px;align-items:center;height:100%}
.pg-it-ascent *,.pg-it-derive *,.pg-it-step-derive *,.pg-it-loop *{min-width:0;max-width:100%;box-sizing:border-box}
.pg-it-stack{display:grid;gap:14px;align-content:center}.pg-it-curve{display:grid;gap:14px}.pg-it-curve>svg{width:100%;height:245px;max-width:100%}.pg-it-axis{display:flex;justify-content:space-between;gap:12px}
.pg-it-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.pg-it-facts.three{grid-template-columns:repeat(3,minmax(0,1fr))}.pg-it-facts>div{display:grid;gap:8px;padding:14px 12px;background:#edf2f8;border-radius:12px;text-align:center}
.pg-it-result{display:grid;gap:8px;border-left:4px solid #df9b4e;padding:14px 20px;background:#faf4e8;border-radius:10px}
.pg-it-derive{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:20px 40px;align-content:center;height:100%}
.pg-it-route-picks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.pg-it-route-picks>div{display:grid;gap:14px;justify-items:center;padding:18px 12px;border-radius:14px;border:2px solid #e3eaf1}.pg-it-route-picks>div.is-selected{border-color:#315b7b;background:#f2f6f9}
.pg-it-route-icon{width:100%;max-width:100%}.pg-it-route-icon svg{width:100%;height:150px}
.pg-it-identity{display:grid;gap:5px;padding:10px 16px;border-top:1px solid #d8e1e9}
.pg-it-wide-rule{display:grid;gap:6px;grid-column:1/-1;padding:10px 18px;background:#edf2f8;border-radius:12px}
.pg-it-step-derive,.pg-it-loop{height:100%;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:14px}
.pg-it-step-scene,.pg-it-loop-scene{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr);gap:42px;align-items:center}
.pg-it-board .pg-world{width:300px}.pg-it-board .pg-hero-marker.is-fox,.pg-it-board .pg-fox-avatar{width:72px;height:72px}
.pg-it-rewards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.pg-it-rewards .edu-btn{display:grid;gap:6px;padding:10px 5px;justify-items:center}.pg-it-rewards .is-past{opacity:.45}.pg-it-rewards .is-future{background:#e4edf5}.pg-it-rewards .is-active{outline:2px solid #315b7b;background:#d0e0ed}
.pg-it-loop-artifacts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.pg-it-loop-artifacts>div{display:grid;gap:10px;padding:16px 10px;border:2px solid #e3eaf1;border-radius:12px}.pg-it-loop-artifacts .is-current{border-color:#315b7b;background:#edf2f8}
.pg-it-loop .pg-it-board .pg-world{width:270px}
.pg-it-ascent .edu-range{margin:0;width:100%;box-sizing:border-box}
.pg-it-route-picks .pg-it-board .pg-world{width:210px;padding:9px}.pg-it-route-picks .pg-hero-marker.is-fox,.pg-it-route-picks .pg-fox-avatar{width:52px;height:52px}
.pg-it-step-scene .pg-it-stack{gap:8px}.pg-it-step-derive .pg-it-board .pg-world{width:260px}
.pg-it-wide-rule{padding:6px 16px;gap:4px}.pg-it-route-picks .pg-hero-marker.is-fox,.pg-it-route-picks .pg-fox-avatar{width:44px;height:44px}
.pg-it-step-derive{gap:8px}
