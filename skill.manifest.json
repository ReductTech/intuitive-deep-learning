{
  "schemaVersion": 1,
  "name": "intuitive-deep-learning",
  "version": "1.0.0",
  "description": "Native Windows development for interactive deep-learning courses",
  "runtime": {
    "type": "command",
    "workingDirectory": "."
  },
  "requirements": {
    "commands": [
      "powershell.exe",
      "python"
    ],
    "ports": [
      59411,
      59413,
      28431,
      28432
    ]
  },
  "lifecycle": {
    "bootstrap": {
      "cmd": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/devstart.ps1"
      ],
      "timeoutMs": 120000,
      "required": true
    },
    "validate": {
      "cmd": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/devstart.ps1",
        "-Status"
      ],
      "timeoutMs": 10000,
      "required": true
    },
    "stop": {
      "cmd": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/devstop.ps1"
      ],
      "timeoutMs": 30000,
      "required": false
    }
  },
  "actions": {
    "preparePage": {
      "cmd": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/devstart.ps1"
      ],
      "timeoutMs": 120000,
      "requiresReady": false
    }
  }
}
