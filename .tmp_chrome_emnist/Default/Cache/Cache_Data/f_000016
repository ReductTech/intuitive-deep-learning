export const pages = [{"id":"digit-recognition-opening","title":"计算机如何读懂手写数字？","goal":"建立手写数字识别的输入与输出问题，暂时把识别器当作黑盒。","summary":"从银行支票的手写金额出发，把数字识别理解为“输入一张图像，输出一个数字类别”的问题。","interaction":"在支票金额格中书写，观察右侧演示窗口的输出；说明当前识别为模拟。","next":"接下来：数字之间有什么不同？。","snippet":"先从银行支票的金额开始。机器得到手写数字的图像，需要给出数字类别。现在先观察输入和输出，后面再打开黑盒。"},{"id":"digit-differences","title":"数字之间有什么不同？","goal":"说出区分数字类别时可能依赖的笔画、开口、弯曲和相对位置。","summary":"面对不同写法的手写数字，先思考人究竟依据哪些视觉线索判断它们属于不同类别。","interaction":"并置不同写法的真实数字，选择或标出自己判断时关注的部位。","next":"接下来：直接比较像素可靠吗？。","snippet":"人看到不同笔迹，仍能判断它们是什么数字。我们先观察自己究竟看了哪些形状线索。"},{"id":"raw-pixel-variation","title":"直接比较像素可靠吗？","goal":"发现相同类别的图像也可能存在很大的逐像素差异。","summary":"同一个数字的笔迹位置、粗细和形状都可能不同，因此逐像素比较并不能稳定描述一个数字。","interaction":"移动或切换同类笔迹，对照像素差异和人眼判断。","next":"接下来：从图像中提取特征。","snippet":"同样是一个数字，笔迹只要稍微平移或变粗，许多像素就改变了。逐格相同并不是可靠的识别依据。"},{"id":"feature-extraction","title":"从图像中提取特征","goal":"理解特征是为了判断任务而从图像中提取的描述。","summary":"与其保存所有像素，不如提取能够概括数字形状的少量信息，这些信息就是特征。","interaction":"对照原始图像与几种简化描述，判断哪些信息有助于区分类别。","next":"接下来：人工设计数字特征。","snippet":"如果不逐格记住整张图，我们可以保留少量与形状有关的信息。这些用于判断的信息就是特征。"},{"id":"manual-nine-grid","title":"人工设计数字特征","goal":"理解九宫格计数规则及其由人预先指定的性质。","summary":"把数字划分为九个区域并统计各区域的亮像素数量，得到第一组人为规定的视觉特征。","interaction":"在一个区域内计数亮像素，再观察九个区域的统计结果。","next":"接下来：特征的向量表示。","snippet":"把数字分成九格，每格数一数亮像素。这样，一张图就有了九个由我们设计的形状描述。"},{"id":"manual-feature-vector","title":"特征的向量表示","goal":"理解向量中每个位置必须始终对应同一个图像区域。","summary":"将九个区域的统计值按照固定顺序排列，就可以把一张图像表示成一个特征向量。","interaction":"按从左上到右下的顺序排列九个计数，比较打乱顺序后的含义。","next":"接下来：基于人工特征的数字分类。","snippet":"九个计数按固定顺序排起来，就是这张图的特征向量。相同位置必须指向相同的区域，数字之间才可比较。"},{"id":"manual-feature-classifier","title":"基于人工特征的数字分类","goal":"区分人工固定的特征规则和通过训练得到的分类参数。","summary":"分类器学习人工特征与数字类别之间的关系，从而完成第一次真正的手写数字识别。","interaction":"训练读取九宫格向量的分类器，再用未见过的手写数字测试。","next":"接下来：人工特征能表达什么？。","snippet":"现在让分类器学习九个统计值与数字类别的关系。九宫格规则没有变化，学习发生在后端分类器。"},{"id":"manual-feature-capacity","title":"人工特征能表达什么？","goal":"认识九宫格的表达范围和信息损失。","summary":"九宫格能够描述笔画的大致分布，却难以保留边缘、方向和局部形状等更细致的信息。","interaction":"比较九宫格向量相近而原始笔画不同的数字，找出丢失的局部信息。","next":"接下来：从区域统计到局部特征。","snippet":"九个计数能说明墨迹大概分布在哪里，却说不清那里是一条边、一个弯，还是一处交叉。"},{"id":"local-features","title":"从区域统计到局部特征","goal":"从整体区域计数过渡到局部形状匹配。","summary":"如果在图像的局部区域中寻找特定形状，就能比九宫格统计保留更多空间结构信息。","interaction":"用一个局部模板扫过数字，观察匹配位置和响应。","next":"接下来：固定卷积特征的数字分类。","snippet":"比起数一大片区域中的亮点，我们可以在小范围内寻找具体形状，再记录它出现在哪里。"},{"id":"fixed-digit-classification","title":"固定卷积特征的数字分类","goal":"理解固定卷积核提取特征、后端分类器学习类别的两段式结构。","summary":"使用多个人工设计的卷积核提取局部特征，再训练分类器完成数字识别。","interaction":"切换固定卷积核、选择或手写数字，训练分类器并查看预测。","next":"接下来：不同特征带来不同结果。","snippet":"多个人工设计的卷积核从图像中提取局部特征。我们暂时固定这些核，只训练后面的分类器。"},{"id":"fixed-feature-limit","title":"不同特征带来不同结果","goal":"在一致数据与训练条件下比较不同固定卷积核的影响。","summary":"更换卷积核会改变模型看到的特征，因此人工选择什么特征会直接影响最终分类结果。","interaction":"切换卷积核组合，对照特征图、困难样本与分类结果。","next":"接下来：从单数字到数字序列。","snippet":"同一张数字在不同卷积核下会变成不同特征图。后端能学到什么，取决于前端交给它什么信息。"},{"id":"single-to-sequence","title":"从单数字到数字序列","goal":"发现单字分类器需要一个局部输入区域才能处理长图。","summary":"单个数字能够识别后，当一张图中同时出现多个数字，首先需要确定每次应该读取哪一部分。","interaction":"把单字输入框放到连续数字的不同位置，观察完整与残缺输入。","next":"接下来：滑动窗口识别。","snippet":"分类器一次只读一个数字大小的图像。面对一串数字，首先要决定每次让它看哪里。"},{"id":"sliding-window","title":"滑动窗口识别","goal":"理解滑动窗口如何复用单字分类器。","summary":"让固定大小的窗口在图像上移动，就可以反复调用同一个单数字分类器处理连续数字。","interaction":"拖动或播放窗口，逐位置查看类别输出。","next":"接下来：无效窗口与拒识。","snippet":"让窗口从左向右移动，每到一个位置就调用同一个分类器，连续图像便被拆成一系列局部判断。"},{"id":"invalid-window-rejection","title":"无效窗口与拒识","goal":"理解拒识类别防止每个窗口被强行判成数字。","summary":"滑动窗口会遇到空白、残缺数字和混合区域，因此模型需要能够判断“这里没有完整目标”。","interaction":"比较有效窗口与空白、残缺、混合窗口，决定何时应拒识。","next":"接下来：从分类响应到目标位置。","snippet":"窗口并不总是正好框住一个数字。遇到空白或残缺笔画时，合理的输出应该是没有完整目标。"},{"id":"response-to-location","title":"从分类响应到目标位置","goal":"理解窗口类别响应与空间位置之间的对应。","summary":"比较目标类别在不同窗口中的响应大小，就可以进一步推断目标最可能出现的位置。","interaction":"查看目标类别的响应沿扫描路径如何变化，并标出峰值位置。","next":"接下来：寻找老六。","snippet":"每个窗口的判断都有一个位置。把目标类别的响应放回扫描路径，高响应处就成为候选位置。"},{"id":"locate-six","title":"寻找老六","goal":"串起扫描、分类、拒识、比较响应和位置输出。","summary":"通过完整的滑窗搜索实验，把分类器第一次扩展成一个能够寻找目标位置的简单视觉系统。","interaction":"在长图中预测数字 6 所在位置，运行滑窗搜索并检查结果。","next":"接下来：人工设计特征的局限。","snippet":"现在把前面的步骤接起来：扫描图像、逐窗判断、排除无效窗口，再找出数字 6 最可能出现的位置。"},{"id":"hand-designed-feature-limit","title":"人工设计特征的局限","goal":"明确固定特征流程中可学习部分与人工设定部分的边界。","summary":"无论九宫格还是固定卷积核，分类器虽然能够学习，但“应该看什么”始终由人提前规定。","interaction":"并列回顾九宫格与固定卷积核，标出训练中会变与不会变的参数。","next":"接下来：可学习卷积核。","snippet":"九宫格和固定卷积核都能支持分类，但特征提取规则始终由人确定。我们能否让它也随任务改变？"},{"id":"learnable-kernel","title":"可学习卷积核","goal":"理解卷积核数值由固定常量变为可训练参数的变化。","summary":"如果把卷积核中的权重也变成模型参数，特征提取规则就可以根据任务本身进行调整。","interaction":"对照固定核与可学习核，调整一处权重并观察特征响应。","next":"接下来：卷积参数如何学习。","snippet":"把卷积核中的数值交给训练过程，模型就能根据识别任务改变自己提取特征的方式。"},{"id":"optimize-kernel","title":"卷积参数如何学习","goal":"追踪误差从输出端回传到卷积权重的一次更新。","summary":"分类误差通过反向传播传递到卷积核，使前端特征提取与后端分类器共同优化。","interaction":"逐步执行前向预测、计算误差、回传梯度和更新参数。","next":"接下来：从卷积层到卷积神经网络。","snippet":"分类错误会沿计算路径传回卷积核。前端特征与后端判断都朝同一个任务目标调整。"},{"id":"convolution-network-unit","title":"从卷积层到卷积神经网络","goal":"把卷积层、激活、池化、分类器连成完整的可训练网络。","summary":"多组可学习卷积核配合激活和池化逐层堆叠，形成能够端到端训练的 CNN。","interaction":"逐层展开网络，查看各层输入、输出及可训练参数。","next":"接下来：层级特征表示。","snippet":"多个卷积核组成一层。卷积、激活和池化可以逐层堆叠，再接上分类器，就得到完整的 CNN。"},{"id":"hierarchical-features","title":"层级特征表示","goal":"观察由局部笔画到组合形状的层级表示。","summary":"随着网络逐层加深，简单的局部响应可以被不断组合成更复杂、更具有判别力的视觉特征。","interaction":"选择不同层的响应，追踪它们对应的输入区域。","next":"接下来：LeNet-5。","snippet":"浅层感受局部笔画，深层组合较大范围的信息。网络逐渐建立更有判别力的表示。"},{"id":"lenet-five","title":"LeNet-5","goal":"认识 LeNet-5 的历史位置和整体任务。","summary":"LeNet-5 将卷积、下采样与分类完整组织成一个经典网络，为手写字符识别提供了系统方案。","interaction":"阅读原论文结构图，并与此前搭建的 CNN 组件对应。","next":"接下来：LeNet-5 的网络结构。","snippet":"LeNet-5 把卷积、下采样和分类连接成一个完整系统，是理解经典卷积网络的好例子。"},{"id":"lenet-structure","title":"LeNet-5 的网络结构","goal":"能沿原版层名和连接顺序解释一次前向计算。","summary":"沿输入、C1、S2、C3、S4、C5、F6 到输出层，理解图像如何逐步转化为类别判断。","interaction":"逐层查看特征图尺度、通道和当前处理结果。","next":"接下来：从数字识别到人脸识别。","snippet":"从输入经过 C1、S2、C3、S4、C5、F6 到输出层，每一步都改变图像的表示，最终给出类别判断。"},{"id":"digits-to-faces","title":"从数字识别到人脸识别","goal":"将数字识别的输入、特征、输出框架迁移到真实 RGB 人脸。","summary":"当输入从手写数字变为真实人脸时，基本的 CNN 思想不变，但需要学习更加复杂的视觉特征。","interaction":"比较数字与人脸样本中的颜色、光照、姿态和局部结构变化。","next":"接下来：固定特征与可学习特征的人脸识别。","snippet":"从小尺寸灰度数字走向真实彩色人脸，问题仍是由图像形成判断，但外观变化更复杂。"},{"id":"face-feature-comparison","title":"固定特征与可学习特征的人脸识别","goal":"在一致任务和数据条件下比较两类特征提取方式。","summary":"在同一人脸任务上比较固定卷积特征与端到端学习特征，观察两种方案的本质差异。","interaction":"并列训练固定特征基线与可学习 CNN，比较特征和验证表现。","next":"接下来：人脸识别与人脸验证。","snippet":"固定特征先由人指定，再训练分类器；可学习特征则随着身份任务一起调整。用同一任务观察两者差别。"},{"id":"identity-vs-verification","title":"人脸识别与人脸验证","goal":"区分单张脸身份分类与两张脸的相似度验证。","summary":"从“这是谁”的身份分类进一步走向“两张脸是不是同一个人”的特征相似度判断。","interaction":"为单图分类与双图验证分别选择合适的输入和输出。","next":"接下来：雨花弄：复杂外观下的人脸验证。","snippet":"身份分类问这是谁。人脸验证则问两张脸是不是同一个人，需要比较两份特征表示。"},{"id":"disguise-verification","title":"雨花弄：复杂外观下的人脸验证","goal":"在复杂外观变化下检验相似度判断，并区分实验模型与此前的身份分类器。","summary":"通过乔装改变外观，观察人脸特征相似度如何变化，并综合应用前面建立的视觉特征学习思想。","interaction":"在故事场景中改变外观，查看独立验证模型返回的相似度。","next":"接下来：从识别到空间视觉任务。","snippet":"乔装会改变人脸图像，却不改变人的身份。观察特征相似度怎样变化，检验验证系统的表现。"},{"id":"classification-to-spatial","title":"从识别到空间视觉任务","goal":"区分类别、目标位置和像素区域三种输出。","summary":"分类主要回答“是什么”，接下来还需要解决“在哪里”和“哪些像素属于目标”，进入目标检测与图像分割。","interaction":"对同一图像切换分类、检测和分割问题，观察输出形式。","next":"进入后续目标检测与图像分割课程。","snippet":"识别回答是什么。视觉系统还可以指出目标在哪里、哪些像素属于它，这将引向检测与分割。"}];
